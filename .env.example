# Banana AI Configuration
# Copy this file to .env and update with your settings

# ===================
# Local AI Settings
# ===================

# Default local model to use with Ollama
# Options: llama3.2:3b, llama3.2:8b, mistral:7b, codellama:7b, etc.
BANANA_LOCAL_MODEL_NAME=llama3.2:3b

# Ollama server address (default: http://localhost:11434)
BANANA_OLLAMA_HOST=http://localhost:11434

# Use GPU acceleration if available
BANANA_USE_GPU=true

# Maximum context length for conversations
BANANA_MAX_CONTEXT_LENGTH=4096

# ===================
# Internet Settings
# ===================

# Enable/disable internet connectivity
BANANA_INTERNET_ENABLED=true

# Prefer local model over internet when possible
BANANA_PREFER_LOCAL=true

# ===================
# API Keys (Optional)
# ===================

# OpenAI API Key for ChatGPT
# Get yours at: https://platform.openai.com/api-keys
BANANA_OPENAI_API_KEY=

# Anthropic API Key for Claude
# Get yours at: https://console.anthropic.com/
BANANA_ANTHROPIC_API_KEY=

# Google API Key for web search
# Get yours at: https://console.developers.google.com/
BANANA_GOOGLE_API_KEY=

# Google Custom Search Engine ID
# Create at: https://programmablesearchengine.google.com/
BANANA_GOOGLE_CSE_ID=

# ===================
# Training Settings
# ===================

# Batch size for training (reduce if running out of memory)
BANANA_TRAINING_BATCH_SIZE=4

# Number of training epochs
BANANA_TRAINING_EPOCHS=3

# Learning rate
BANANA_LEARNING_RATE=0.0002

# LoRA rank (higher = more parameters, better quality but more memory)
BANANA_LORA_RANK=16
BANANA_LORA_ALPHA=32

# ===================
# Server Settings
# ===================

# Web server host and port
BANANA_SERVER_HOST=127.0.0.1
BANANA_SERVER_PORT=8000

# ===================
# Storage Paths
# ===================

# Directory for data storage
BANANA_DATA_DIR=./data

# Directory for saved models
BANANA_MODELS_DIR=./models

# Directory for cache
BANANA_CACHE_DIR=./cache

# Vector store path for knowledge base
BANANA_VECTOR_STORE_PATH=./data/vectorstore
