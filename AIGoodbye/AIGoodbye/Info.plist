<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the share extension, widgets and Control Center open the app.
	     Everything else in Info.plist is generated from build settings. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.aigoodbye.AIGoodbye</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aigoodbye</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
