<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The recorder keeps capturing a meeting when the screen locks or the
	     user switches apps; without this the audio session is suspended and
	     the recording silently dies mid-sentence. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Lets the share extension, widgets and Control Center open the app.
	     Everything else in Info.plist is generated from build settings. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.aigoodbye.AIGoodbye</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>aigoodbye</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
