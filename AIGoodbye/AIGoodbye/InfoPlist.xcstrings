{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye nutzt die Kamera, damit du Fotos aufnehmen, Dokumente scannen und Fragen dazu stellen kannst, was die Kamera sieht – auch mit „Umgebung beschreiben“. Bilder werden auf deinem Gerät ausgewertet und nie aufgezeichnet oder hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρησιμοποιεί την κάμερα για να τραβάς φωτογραφίες, να σαρώνεις έγγραφα και να ρωτάς για ό,τι βλέπει η κάμερα, και με την «Περιγραφή περιβάλλοντος». Οι εικόνες αναλύονται στη συσκευή σου και δεν καταγράφονται ούτε ανεβαίνουν ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye uses the camera so you can take photos, scan documents and ask about what the camera sees, including Describe Surroundings. Images are analyzed on your device and never recorded or uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa la cámara para que puedas hacer fotos, escanear documentos y preguntar sobre lo que ve la cámara, también con «Describir el entorno». Las imágenes se analizan en tu dispositivo y nunca se graban ni se suben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye utilise l'appareil photo pour que vous puissiez prendre des photos, numériser des documents et poser des questions sur ce que voit l'appareil photo, y compris avec « Décrire l'environnement ». Les images sont analysées sur votre appareil et ne sont jamais enregistrées ni envoyées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa la fotocamera per scattare foto, scansionare documenti e fare domande su ciò che inquadra, anche con «Descrivi l'ambiente». Le immagini vengono analizzate sul tuo dispositivo e non vengono mai registrate né caricate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは、写真の撮影、書類のスキャン、そして「周囲を説明」を含め、カメラに映っているものについて質問するためにカメラを使用します。画像はデバイス上で解析され、記録やアップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 사진 촬영, 문서 스캔, 그리고 ‘주변 설명’을 포함해 카메라에 보이는 것에 대해 질문할 수 있도록 카메라를 사용합니다. 이미지는 기기에서 분석되며 절대 기록되거나 업로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye usa a câmera para você tirar fotos, digitalizar documentos e perguntar sobre o que a câmera vê, inclusive com “Descrever o ambiente”. As imagens são analisadas no seu dispositivo e nunca são gravadas nem enviadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye использует камеру, чтобы вы могли делать фото, сканировать документы и задавать вопросы о том, что видит камера, в том числе в режиме «Описать окружение». Изображения анализируются на вашем устройстве и никогда не записываются и не отправляются в интернет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye використовує камеру, щоб ви могли робити фото, сканувати документи й запитувати про те, що бачить камера, зокрема в режимі «Описати оточення». Зображення аналізуються на вашому пристрої й ніколи не записуються та не надсилаються в інтернет."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用相機，等你可以影相、掃描文件，同埋查詢相機見到嘅嘢，包括「描述周遭環境」功能。影像會喺你嘅裝置上分析，絕不會錄低或者上載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用相机，让你可以拍照、扫描文稿，并询问相机看到的内容，包括“描述周围环境”功能。图像在你的设备上分析，绝不会被录制或上传。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye nutzt das Mikrofon für Sprachunterhaltungen, Übersetzungen und die Meeting-Aufnahme. Audio wird ausschließlich auf deinem Gerät verarbeitet und nie hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρησιμοποιεί το μικρόφωνο για φωνητικές συνομιλίες, μετάφραση και την εγγραφή συσκέψεων. Η επεξεργασία του ήχου γίνεται αποκλειστικά στη συσκευή σου και ο ήχος δεν ανεβαίνει ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye uses the microphone for voice conversations, translation and the meeting recorder. Audio is processed entirely on your device and never uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa el micrófono para conversaciones de voz, traducción y la grabadora de reuniones. El audio se procesa únicamente en tu dispositivo y nunca se sube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye utilise le micro pour les conversations vocales, la traduction et l'enregistreur de réunions. L'audio est traité entièrement sur votre appareil et n'est jamais envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa il microfono per le conversazioni vocali, la traduzione e il registratore di riunioni. L'audio viene elaborato interamente sul tuo dispositivo e non viene mai caricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは、音声会話、翻訳、会議レコーダーのためにマイクを使用します。音声はすべてデバイス上で処理され、アップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 음성 대화, 번역, 회의 녹음을 위해 마이크를 사용합니다. 오디오는 전적으로 기기에서 처리되며 절대 업로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye usa o microfone para conversas por voz, tradução e o gravador de reuniões. O áudio é processado inteiramente no seu dispositivo e nunca é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye использует микрофон для голосовых разговоров, перевода и диктофона для встреч. Звук обрабатывается только на вашем устройстве и никогда не отправляется в интернет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye використовує мікрофон для голосових розмов, перекладу та диктофона для зустрічей. Звук обробляється лише на вашому пристрої й ніколи не надсилається в інтернет."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 用麥克風嚟進行語音對話、翻譯同會議錄音。音訊全部喺你部裝置上處理，絕對唔會上載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用麦克风进行语音对话、翻译和会议录音。音频完全在你的设备上处理，绝不会上传。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye wandelt Sprache nur auf diesem Gerät in Text um. Es wird nichts gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye μετατρέπει την ομιλία σου σε κείμενο μόνο σε αυτήν τη συσκευή. Τίποτα δεν αποστέλλεται πουθενά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye converts your speech to text on this device only. Nothing is sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye convierte tu voz en texto solo en este dispositivo. No se envía nada a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye convertit votre voix en texte uniquement sur cet appareil. Rien n'est envoyé nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye converte la tua voce in testo solo su questo dispositivo. Non viene inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは音声をこのデバイス上でのみテキストに変換します。どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 이 기기에서만 음성을 텍스트로 변환합니다. 아무것도 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye converte sua fala em texto somente neste dispositivo. Nada é enviado a lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye преобразует речь в текст только на этом устройстве. Ничего никуда не отправляется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye перетворює мовлення на текст лише на цьому пристрої. Нічого нікуди не надсилається."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 只會喺呢部裝置上將你嘅語音轉成文字。乜嘢都唔會傳送出去。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 仅在本设备上将你的语音转换为文字。不会发送任何内容。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye uses Face ID to unlock your private conversations. Nothing about your face ever leaves the device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye verwendet Face ID, um deine privaten Unterhaltungen zu entsperren. Nichts über dein Gesicht verlässt jemals das Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρησιμοποιεί το Face ID για να ξεκλειδώνει τις ιδιωτικές σου συνομιλίες. Τίποτα σχετικό με το πρόσωπό σου δεν φεύγει ποτέ από τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa Face ID para desbloquear tus conversaciones privadas. Nada sobre tu rostro sale nunca del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye utilise Face ID pour déverrouiller vos conversations privées. Rien concernant votre visage ne quitte jamais l'appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa Face ID per sbloccare le tue conversazioni private. Nulla del tuo volto lascia mai il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye は Face ID を使って、プライベートな会話のロックを解除します。顔に関する情報が端末の外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 Face ID로 비공개 대화의 잠금을 해제합니다. 얼굴에 관한 정보는 기기 밖으로 나가지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye usa o Face ID para desbloquear suas conversas privadas. Nada sobre o seu rosto sai do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye использует Face ID, чтобы разблокировать ваши личные переписки. Данные о вашем лице никогда не покидают устройство."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye використовує Face ID, щоб розблокувати ваші приватні розмови. Дані про ваше обличчя ніколи не залишають пристрій."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用面容 ID 解锁你的私人对话。有关你面容的任何信息都不会离开本设备。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用 Face ID 解鎖你的私人對話。有關你面容的任何資訊都不會離開本裝置。"
          }
        }
      }
    }
  },
  "version": "1.0"
}