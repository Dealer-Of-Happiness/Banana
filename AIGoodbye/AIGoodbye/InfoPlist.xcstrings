{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye nutzt die Kamera, damit du Fotos aufnehmen oder Fragen zur Live-Ansicht stellen kannst. Bilder werden auf deinem Gerät analysiert und niemals aufgezeichnet oder hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρησιμοποιεί την κάμερα για να τραβάτε φωτογραφίες ή να ρωτάτε για τη ζωντανή προβολή. Οι εικόνες αναλύονται στη συσκευή σας και δεν καταγράφονται ούτε μεταφορτώνονται ποτέ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye uses the camera so you can take photos or ask about a live view. Images are analyzed on your device and never recorded or uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa la cámara para que puedas hacer fotos o preguntar sobre lo que ve la cámara. Las imágenes se analizan en tu dispositivo y nunca se graban ni se suben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye utilise l'appareil photo pour prendre des photos ou poser des questions sur la vue en direct. Les images sont analysées sur votre appareil et ne sont jamais enregistrées ni téléversées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa la fotocamera per scattare foto o fare domande sulla vista dal vivo. Le immagini vengono analizzate sul tuo dispositivo e non sono mai registrate né caricate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは写真の撮影やライブ映像についての質問のためにカメラを使用します。画像はデバイス上で解析され、録画やアップロードは一切行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 사진 촬영이나 실시간 화면에 대한 질문을 위해 카메라를 사용합니다. 이미지는 기기에서 분석되며 녹화하거나 업로드하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye usa a câmera para você tirar fotos ou perguntar sobre a visualização ao vivo. As imagens são analisadas no seu dispositivo e nunca são gravadas nem enviadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye использует камеру, чтобы вы могли снимать фото или задавать вопросы о том, что видит камера. Изображения анализируются на вашем устройстве и никогда не записываются и не выгружаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye використовує камеру, щоб ви могли робити фото або запитувати про те, що бачить камера. Зображення аналізуються на вашому пристрої й ніколи не записуються та не завантажуються."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 用相機，等你可以影相或者問即時畫面。圖片喺你部裝置上分析，絕對唔會錄影或上載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用相机，让您拍照或询问实时画面。图像在您的设备上分析，绝不录制或上传。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye nutzt das Mikrofon für private Sprachunterhaltungen. Audio wird ausschließlich auf deinem Gerät verarbeitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρησιμοποιεί το μικρόφωνο για ιδιωτικές φωνητικές συνομιλίες. Ο ήχος επεξεργάζεται μόνο στη συσκευή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye uses the microphone for private voice conversations. Audio is processed entirely on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa el micrófono para conversaciones de voz privadas. El audio se procesa únicamente en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye utilise le micro pour des conversations vocales privées. L'audio est traité uniquement sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa il microfono per conversazioni vocali private. L'audio viene elaborato solo sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeはプライベートな音声会話のためにマイクを使用します。音声はデバイス上でのみ処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 프라이빗 음성 대화를 위해 마이크를 사용합니다. 오디오는 기기에서만 처리됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye usa o microfone para conversas de voz privadas. O áudio é processado somente no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye использует микрофон для приватных голосовых бесед. Звук обрабатывается только на вашем устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye використовує мікрофон для приватних голосових розмов. Звук обробляється лише на вашому пристрої."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 用麥克風進行私密語音對話。音訊只會喺你部裝置上處理。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用麦克风进行私密语音对话。音频仅在您的设备上处理。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye verwendet Ihre Fotomediathek, um Bilder für die Analyse auszuwählen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AIGoodbye χρησιμοποιεί τη βιβλιοθήκη φωτογραφιών σας για την επιλογή εικόνων προς ανάλυση"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye uses your photo library to select images for analysis"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye usa tu fototeca para seleccionar imágenes y analizarlas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye utilise votre photothèque pour sélectionner des images à analyser"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye usa la tua libreria foto per selezionare immagini da analizzare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbyeは分析する画像を選択するためにフォトライブラリを使用します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye는 분석할 이미지를 선택하기 위해 사진 보관함을 사용합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AIGoodbye usa sua fototeca para selecionar imagens para análise"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye использует вашу медиатеку для выбора изображений для анализа"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye використовує вашу медіатеку для вибору зображень для аналізу"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye 使用你的相片圖庫選擇要分析的圖像"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AIGoodbye 使用您的照片图库来选择要分析的图像"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye wandelt Sprache nur auf diesem Gerät in Text um. Es wird nichts gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye μετατρέπει την ομιλία σας σε κείμενο μόνο σε αυτήν τη συσκευή. Τίποτα δεν αποστέλλεται πουθενά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye converts your speech to text on this device only. Nothing is sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye convierte tu voz en texto solo en este dispositivo. No se envía nada a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye convertit votre voix en texte uniquement sur cet appareil. Rien n'est envoyé nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye converte la tua voce in testo solo su questo dispositivo. Non viene inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは音声をこのデバイス上でのみテキストに変換します。どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 이 기기에서만 음성을 텍스트로 변환합니다. 아무것도 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye converte sua fala em texto somente neste dispositivo. Nada é enviado a lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye преобразует речь в текст только на этом устройстве. Ничего никуда не отправляется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye перетворює мовлення на текст лише на цьому пристрої. Нічого нікуди не надсилається."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 只會喺呢部裝置上將你嘅語音轉成文字。乜嘢都唔會傳送出去。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 仅在本设备上将您的语音转换为文字。不会发送任何内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}