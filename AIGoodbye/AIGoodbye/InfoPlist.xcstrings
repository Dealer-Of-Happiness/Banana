{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye nutzt die Kamera, damit du Fotos aufnehmen oder Fragen zum Live-Bild stellen kannst. Bilder werden auf deinem Gerät ausgewertet und nie hochgeladen. Gesendete Fotos bleiben nur in dieser Unterhaltung auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρησιμοποιεί την κάμερα για να τραβάτε φωτογραφίες ή να ρωτάτε για τη ζωντανή εικόνα. Οι εικόνες αναλύονται στη συσκευή σας και δεν ανεβαίνουν ποτέ. Οι φωτογραφίες που στέλνετε μένουν μόνο μέσα σε αυτή τη συνομιλία, σε αυτή τη συσκευή."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye uses the camera so you can take photos or ask about a live view. Images are analyzed on your device and never uploaded. Photos you send are kept only inside that conversation on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa la cámara para que puedas hacer fotos o preguntar sobre la imagen en directo. Las imágenes se analizan en tu dispositivo y nunca se suben. Las fotos que envías se guardan solo dentro de esa conversación en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye utilise l'appareil photo pour que vous puissiez prendre des photos ou poser des questions sur l'image en direct. Les images sont analysées sur votre appareil et jamais envoyées. Les photos que vous envoyez restent uniquement dans cette conversation, sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa la fotocamera per scattare foto o fare domande sull'inquadratura in tempo reale. Le immagini vengono analizzate sul tuo dispositivo e non vengono mai caricate. Le foto che invii restano solo in quella conversazione, su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは、写真を撮ったりライブ映像について質問したりするためにカメラを使用します。画像はデバイス上で解析され、アップロードされることはありません。送信した写真はこのデバイスのその会話内にのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 사진을 찍거나 실시간 화면에 대해 질문할 수 있도록 카메라를 사용합니다. 이미지는 기기에서 분석되며 절대 업로드되지 않습니다. 보낸 사진은 이 기기의 해당 대화 안에만 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye usa a câmera para você tirar fotos ou perguntar sobre a imagem ao vivo. As imagens são analisadas no seu aparelho e nunca enviadas. As fotos que você envia ficam apenas naquela conversa, neste aparelho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye использует камеру, чтобы вы могли делать фото или задавать вопросы о том, что она видит. Изображения анализируются на вашем устройстве и никогда не отправляются в интернет. Отправленные фото хранятся только в этом чате на этом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye використовує камеру, щоб ви могли робити фото або запитувати про те, що вона бачить. Зображення аналізуються на вашому пристрої й ніколи не надсилаються в інтернет. Надіслані фото зберігаються лише в цьому чаті на цьому пристрої."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用相機，讓你可以影相或查詢即時畫面。影像會喺你嘅裝置上分析，絕不會上載。你傳送嘅相片只會保存喺本裝置嘅該對話入面。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用相机，让你可以拍照或询问实时画面。图像在你的设备上分析，绝不会上传。你发送的照片只保存在本设备的该对话中。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye nutzt das Mikrofon für private Sprachunterhaltungen. Audio wird ausschließlich auf deinem Gerät verarbeitet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρησιμοποιεί το μικρόφωνο για ιδιωτικές φωνητικές συνομιλίες. Ο ήχος επεξεργάζεται μόνο στη συσκευή σας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye uses the microphone for private voice conversations. Audio is processed entirely on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa el micrófono para conversaciones de voz privadas. El audio se procesa únicamente en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye utilise le micro pour des conversations vocales privées. L'audio est traité uniquement sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa il microfono per conversazioni vocali private. L'audio viene elaborato solo sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeはプライベートな音声会話のためにマイクを使用します。音声はデバイス上でのみ処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 프라이빗 음성 대화를 위해 마이크를 사용합니다. 오디오는 기기에서만 처리됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye usa o microfone para conversas de voz privadas. O áudio é processado somente no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye использует микрофон для приватных голосовых бесед. Звук обрабатывается только на вашем устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye використовує мікрофон для приватних голосових розмов. Звук обробляється лише на вашому пристрої."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 用麥克風進行私密語音對話。音訊只會喺你部裝置上處理。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用麦克风进行私密语音对话。音频仅在您的设备上处理。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye wandelt Sprache nur auf diesem Gerät in Text um. Es wird nichts gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye μετατρέπει την ομιλία σας σε κείμενο μόνο σε αυτήν τη συσκευή. Τίποτα δεν αποστέλλεται πουθενά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye converts your speech to text on this device only. Nothing is sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye convierte tu voz en texto solo en este dispositivo. No se envía nada a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye convertit votre voix en texte uniquement sur cet appareil. Rien n'est envoyé nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye converte la tua voce in testo solo su questo dispositivo. Non viene inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは音声をこのデバイス上でのみテキストに変換します。どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 이 기기에서만 음성을 텍스트로 변환합니다. 아무것도 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye converte sua fala em texto somente neste dispositivo. Nada é enviado a lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye преобразует речь в текст только на этом устройстве. Ничего никуда не отправляется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye перетворює мовлення на текст лише на цьому пристрої. Нічого нікуди не надсилається."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 只會喺呢部裝置上將你嘅語音轉成文字。乜嘢都唔會傳送出去。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 仅在本设备上将您的语音转换为文字。不会发送任何内容。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye uses Face ID to unlock your private conversations. Nothing about your face ever leaves the device."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye verwendet Face ID, um deine privaten Unterhaltungen zu entsperren. Nichts über dein Gesicht verlässt jemals das Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρησιμοποιεί το Face ID για να ξεκλειδώνει τις ιδιωτικές σας συνομιλίες. Τίποτα σχετικό με το πρόσωπό σας δεν φεύγει ποτέ από τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa Face ID para desbloquear tus conversaciones privadas. Nada sobre tu rostro sale nunca del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye utilise Face ID pour déverrouiller vos conversations privées. Rien concernant votre visage ne quitte jamais l'appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye usa Face ID per sbloccare le tue conversazioni private. Nulla del tuo volto lascia mai il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye は Face ID を使って、プライベートな会話のロックを解除します。顔に関する情報が端末の外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 Face ID로 비공개 대화의 잠금을 해제합니다. 얼굴에 관한 정보는 기기 밖으로 나가지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye usa o Face ID para desbloquear suas conversas privadas. Nada sobre o seu rosto sai do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye использует Face ID, чтобы разблокировать ваши личные переписки. Данные о вашем лице никогда не покидают устройство."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye використовує Face ID, щоб розблокувати ваші приватні розмови. Дані про ваше обличчя ніколи не залишають пристрій."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用面容 ID 解锁你的私人对话。有关你面容的任何信息都不会离开本设备。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 使用 Face ID 解鎖你的私人對話。有關你面容的任何資訊都不會離開本裝置。"
          }
        }
      }
    }
  },
  "version": "1.0"
}