    "Ask questions, analyze images, or discuss documents. Everything stays on your iPhone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie Fragen, analysieren Sie Bilder oder besprechen Sie Dokumente. Alles bleibt auf Ihrem iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz preguntas, analiza imágenes o comenta documentos. Todo se queda en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez des questions, analysez des images ou discutez de documents. Tout reste sur votre iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai domande, analizza immagini o discuti di documenti. Tutto resta sul tuo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問、画像の分析、書類の相談ができます。すべてはあなたのiPhoneの中だけで行われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça perguntas, analise imagens ou converse sobre documentos. Tudo fica no seu iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задавайте вопросы, анализируйте изображения и обсуждайте документы. Всё остаётся на вашем iPhone."
          }
        },
