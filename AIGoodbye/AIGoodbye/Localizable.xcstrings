    "Your recordings couldn't be opened. Nothing has been deleted - reopen the app, and if this keeps happening please get in touch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahmen konnten nicht geöffnet werden. Es wurde nichts gelöscht – öffne die App erneut, und melde dich bitte, falls das weiterhin passiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατό το άνοιγμα των ηχογραφήσεών σου. Δεν διαγράφηκε τίποτα – άνοιξε ξανά την εφαρμογή και, αν συνεχιστεί, επικοινώνησε μαζί μας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron abrir tus grabaciones. No se ha eliminado nada: vuelve a abrir la app y, si sigue ocurriendo, ponte en contacto con nosotros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements n'ont pas pu être ouverts. Rien n'a été supprimé : rouvrez l'app et, si cela persiste, contactez-nous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprire le tue registrazioni. Non è stato eliminato nulla: riapri l'app e, se continua, contattaci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を開けませんでした。何も削除されていません。アプリを開き直してください。繰り返す場合はご連絡ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 열지 못했습니다. 삭제된 것은 없습니다. 앱을 다시 열어 보시고, 계속 발생하면 연락해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir suas gravações. Nada foi apagado: reabra o app e, se continuar, entre em contato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть ваши записи. Ничего не удалено — перезапустите приложение, и если это повторится, напишите нам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відкрити ваші записи. Нічого не видалено — перезапустіть застосунок, і якщо це повториться, напишіть нам."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟你的錄音。沒有任何內容被刪除——請重新開啟 App，如果仍然如此，請與我們聯絡。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法打开你的录音。没有任何内容被删除——请重新打开 App，如果仍然如此，请与我们联系。"
          }
        }
      }
    },
    "Your recordings couldn't be saved. The device may be out of space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahmen konnten nicht gesichert werden. Möglicherweise ist der Speicher voll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η αποθήκευση των ηχογραφήσεών σου. Ίσως δεν υπάρχει χώρος στη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar tus grabaciones. Puede que el dispositivo no tenga espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements n'ont pas pu être sauvegardés. L'appareil manque peut-être d'espace."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare le tue registrazioni. Il dispositivo potrebbe non avere spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を保存できませんでした。端末の空き容量が不足している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 저장하지 못했습니다. 기기 저장 공간이 부족할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar suas gravações. O dispositivo pode estar sem espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить ваши записи. Возможно, на устройстве нет места."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зберегти ваші записи. Можливо, на пристрої немає місця."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保存你的錄音。裝置可能空間不足。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存你的录音。设备可能空间不足。"
          }
        }
      }
    },
