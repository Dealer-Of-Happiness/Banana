    "About %lld seconds of audio were dropped because the device couldn't keep up. The transcript is unaffected.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Etwa %lld Sekunde Audio ging verloren, weil das Gerät nicht mitkam. Das Transkript ist davon nicht betroffen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Etwa %lld Sekunden Audio gingen verloren, weil das Gerät nicht mitkam. Das Transkript ist davon nicht betroffen."
                }
              }
            }
          }
        },
        "el": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Χάθηκε περίπου %lld δευτερόλεπτο ήχου επειδή η συσκευή δεν πρόλαβε. Η απομαγνητοφώνηση δεν επηρεάστηκε."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Χάθηκαν περίπου %lld δευτερόλεπτα ήχου επειδή η συσκευή δεν πρόλαβε. Η απομαγνητοφώνηση δεν επηρεάστηκε."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "About %lld second of audio was dropped because the device couldn't keep up. The transcript is unaffected."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "About %lld seconds of audio were dropped because the device couldn't keep up. The transcript is unaffected."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se perdió aproximadamente %lld segundo de audio porque el dispositivo no pudo seguir el ritmo. La transcripción no se ve afectada."
                }
              },
              "other": {
                "stringUnit": {
