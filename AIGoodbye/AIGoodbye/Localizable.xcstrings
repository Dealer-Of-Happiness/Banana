          "stringUnit": {
            "state": "translated",
            "value": "Non c'è abbastanza spazio libero per registrare. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するのに十分な空き容量がありません。空き容量を増やしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음할 여유 공간이 부족합니다. 공간을 확보한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço livre suficiente para gravar. Libere espaço e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно свободного места для записи. Освободите место и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо вільного місця для запису. Звільніть місце та спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間不足，無法錄音。請釋放一些空間後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间不足，无法录音。请释放一些空间后重试。"
          }
        }
      }
    },
