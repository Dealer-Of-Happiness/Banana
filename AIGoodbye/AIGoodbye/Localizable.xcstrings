    "You're not on Wi-Fi. This is a large download - it will wait until you are, unless you turn that off in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht im WLAN. Das ist ein großer Download – er wartet, bis du im WLAN bist, sofern du das nicht in den Einstellungen abschaltest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν είσαι σε Wi-Fi. Πρόκειται για μεγάλη λήψη – θα περιμένει μέχρι να συνδεθείς, εκτός αν το απενεργοποιήσεις στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No estás en Wi-Fi. Es una descarga grande: esperará hasta que lo estés, salvo que lo desactives en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'êtes pas en Wi-Fi. Le téléchargement est volumineux : il attendra que vous le soyez, sauf si vous désactivez cette option dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei sotto Wi-Fi. È un download di grandi dimensioni: aspetterà finché non lo sarai, a meno che tu non lo disattivi in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi に接続していません。大きなダウンロードのため、設定でオフにしない限り Wi-Fi に接続するまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi에 연결되어 있지 않습니다. 용량이 큰 다운로드라, 설정에서 끄지 않는 한 Wi-Fi에 연결될 때까지 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não está no Wi-Fi. É um download grande: ele vai esperar até você estar, a menos que desative isso nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не в сети Wi-Fi. Загрузка большая — она подождёт подключения, если вы не отключите это в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не в мережі Wi-Fi. Завантаження велике — воно зачекає на підключення, якщо ви не вимкнете це в параметрах."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你目前未連線 Wi-Fi。這是一個大檔案下載——除非你在「設定」中關閉該選項，否則會等到連上 Wi-Fi 再下載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你当前未连接 Wi-Fi。这是一个大文件下载——除非你在“设置”中关闭该选项，否则会等到连上 Wi-Fi 再下载。"
          }
        }
      }
    },
