          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроено в ваше устройство — мгновенно, без загрузки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудовано у ваш пристрій — миттєво, без завантаження"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
