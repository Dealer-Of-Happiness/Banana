    "Go ahead and chat now - the AI still answers, with no connection at all.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatten Sie ruhig jetzt – die KI antwortet auch ganz ohne Verbindung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ξεκινήστε συνομιλία τώρα — το AI απαντά κανονικά, χωρίς καμία σύνδεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatea ahora mismo: la IA sigue respondiendo, sin ninguna conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discutez dès maintenant : l'IA répond toujours, sans aucune connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi pure adesso: l'IA risponde lo stesso, senza alcuna connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま話しかけてみてください。接続がなくてもAIは答えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 바로 대화해 보세요. 연결이 전혀 없어도 AI는 답합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode conversar agora: a IA continua respondendo, sem conexão nenhuma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишите прямо сейчас — ИИ отвечает даже без всякого подключения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишіть просто зараз — ШІ відповідає навіть без жодного з'єднання."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "而家就傾得，AI 照樣答到你，完全唔使上網。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在就聊聊看吧，AI 照样回答，完全不用联网。"
          }
        }
      }
    },
