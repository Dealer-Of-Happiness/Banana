    "You can delete it anytime in Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst es jederzeit in den Einstellungen löschen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να το διαγράψεις οποτεδήποτε στις Ρυθμίσεις"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes eliminarlo cuando quieras en Ajustes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez le supprimer à tout moment dans Réglages"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi eliminarlo in qualsiasi momento in Impostazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でいつでも削除できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 언제든지 삭제 가능"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode apagá-lo a qualquer momento nos Ajustes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно удалить в любой момент в Настройках"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна будь-коли видалити в Налаштуваннях"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可以隨時在設定中刪除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以随时在设置中删除"
          }
        }
      }
    },
    "You can keep up to %lld added models. Remove one first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst bis zu %lld hinzugefügte Modelle behalten. Entferne zuerst eines."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείς να διατηρήσεις έως %lld πρόσθετα μοντέλα. Αφαίρεσε πρώτα ένα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conservar hasta %lld modelos añadidos. Quita uno primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez conserver jusqu'à %lld modèles ajoutés. Retirez-en un d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi conservare fino a %lld modelli aggiunti. Rimuovine prima uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加できるモデルは最大 %lld 個です。まず 1 つ削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가한 모델은 최대 %lld개까지 보관할 수 있습니다. 먼저 하나를 제거하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode manter até %lld modelos adicionados. Remova um primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно хранить до %lld добавленных моделей. Сначала удалите одну."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна зберігати до %lld доданих моделей. Спершу видаліть одну."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可保留 %lld 個已加入的模型。請先移除一個。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可保留 %lld 个已添加的模型。请先移除一个。"
          }
        }
      }
    },
