    "Live camera needs the %@ vision model. Download it from the chat screen first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Kamera braucht das Vision-Modell %@. Lade es zuerst im Chat-Bildschirm herunter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ζωντανή κάμερα χρειάζεται το μοντέλο όρασης %@. Κατεβάστε το πρώτα από την οθόνη συνομιλίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara en vivo necesita el modelo de visión %@. Descárgalo primero desde la pantalla de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra en direct nécessite le modèle de vision %@. Téléchargez-le d'abord depuis l'écran de discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera live richiede il modello di visione %@. Scaricalo prima dalla schermata della chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブカメラには%@ビジョンモデルが必要です。先にチャット画面からダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 카메라에는 %@ 비전 모델이 필요합니다. 먼저 채팅 화면에서 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera ao vivo precisa do modelo de visão %@. Baixe-o primeiro na tela de chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для живой камеры нужна модель зрения %@. Сначала загрузите её на экране чата."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для живої камери потрібна модель зору %@. Спершу завантажте її на екрані чату."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "即時相機需要 %@ 視覺模型。請先喺傾偈畫面下載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时相机需要 %@ 视觉模型。请先在聊天界面下载。"
          }
        }
      }
    },
    "Lower = more precise, higher = more creative.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedriger = präziser, höher = kreativer."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χαμηλότερη τιμή = μεγαλύτερη ακρίβεια, υψηλότερη = περισσότερη δημιουργικότητα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más bajo = más preciso; más alto = más creativo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus bas = plus précis, plus haut = plus créatif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più basso = più preciso, più alto = più creativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低いほど正確に、高いほど創造的になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮을수록 더 정확하고, 높을수록 더 창의적입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais baixo = mais preciso; mais alto = mais criativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниже — точнее, выше — креативнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нижче — точніше, вище — креативніше."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "數值越低越精準，越高越有創意。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值越低越精确，越高越有创造力。"
          }
        }
      }
    },
