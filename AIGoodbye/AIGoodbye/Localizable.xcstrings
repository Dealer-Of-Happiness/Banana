    "Translating needs the %@ model. Download it from the chat screen first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Übersetzen wird das Modell %@ benötigt. Lade es zuerst im Chat herunter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μετάφραση χρειάζεται το μοντέλο %@. Κατέβασέ το πρώτα από την οθόνη συνομιλίας."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translating needs the %@ model. Download it from the chat screen first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para traducir se necesita el modelo %@. Descárgalo primero desde la pantalla de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La traduction nécessite le modèle %@. Téléchargez-le d'abord depuis l'écran de discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per tradurre serve il modello %@. Scaricalo prima dalla schermata della chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳には%@モデルが必要です。まずチャット画面からダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역에는 %@ 모델이 필요합니다. 먼저 대화 화면에서 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduzir exige o modelo %@. Baixe-o primeiro na tela de conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перевода нужна модель %@. Сначала загрузите её на экране чата."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для перекладу потрібна модель %@. Спочатку завантажте її на екрані чату."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯需要 %@ 模型。請先喺對話畫面下載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译需要 %@ 模型。请先在聊天界面下载。"
          }
