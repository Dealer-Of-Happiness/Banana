        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该模型已添加。"
          }
        }
      }
    },
    "That model is already built in - pick it from the model list.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell ist bereits integriert – wähle es in der Modellliste aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το μοντέλο είναι ήδη ενσωματωμένο – διάλεξέ το από τη λίστα μοντέλων."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That model is already built in - pick it from the model list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese modelo ya viene integrado: elígelo en la lista de modelos."
          }
        },
