    "Nothing you say leaves this device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts, was Sie sagen, verlässt dieses Gerät"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα από όσα λέτε δεν φεύγει από αυτή τη συσκευή"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo que dices sale de este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de ce que vous dites ne quitte cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di ciò che dici lascia questo dispositivo"
