    "Waiting for Wi-Fi. Connect to Wi-Fi, or turn off \"Download over Wi-Fi only\" in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf WLAN. Verbinde dich mit einem WLAN oder schalte „Nur über WLAN laden“ in den Einstellungen aus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αναμονή για Wi-Fi. Συνδέσου σε Wi-Fi ή απενεργοποίησε το «Λήψη μόνο μέσω Wi-Fi» στις Ρυθμίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Wi-Fi. Connect to Wi-Fi, or turn off \"Download over Wi-Fi only\" in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando Wi-Fi. Conéctate a una red Wi-Fi o desactiva «Descargar solo por Wi-Fi» en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente du Wi-Fi. Connectez-vous au Wi-Fi ou désactivez « Télécharger uniquement en Wi-Fi » dans les Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa del Wi-Fi. Connettiti a una rete Wi-Fi oppure disattiva «Scarica solo tramite Wi-Fi» nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fiを待っています。Wi-Fiに接続するか、設定で「Wi-Fiのときだけダウンロード」をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi를 기다리는 중입니다. Wi-Fi에 연결하거나 설정에서 ‘Wi-Fi에서만 다운로드’를 끄세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando Wi-Fi. Conecte-se a uma rede Wi-Fi ou desative “Baixar somente por Wi-Fi” nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание Wi-Fi. Подключитесь к Wi-Fi или выключите «Загружать только по Wi-Fi» в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікування Wi-Fi. Підключіться до Wi-Fi або вимкніть «Завантажувати лише через Wi-Fi» в налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 Wi-Fi。請連接 Wi-Fi，或者喺設定關閉「只用 Wi-Fi 下載」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在等待 Wi-Fi。请连接 Wi-Fi，或在设置中关闭“仅通过 Wi-Fi 下载”。"
          }
        }
      }
    },
