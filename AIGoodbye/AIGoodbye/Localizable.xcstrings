    "Apple Intelligence is still preparing on this device. Try again in a few minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wird auf diesem Gerät noch vorbereitet. Versuchen Sie es in ein paar Minuten erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence προετοιμάζεται ακόμα σε αυτήν τη συσκευή. Δοκιμάστε ξανά σε λίγα λεπτά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún se está preparando en este dispositivo. Inténtalo de nuevo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est encore en cours de préparation sur cet appareil. Réessayez dans quelques minutes."
