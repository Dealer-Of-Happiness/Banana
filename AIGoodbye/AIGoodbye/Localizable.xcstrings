    "Apple Intelligence is still preparing on this device. Try again in a few minutes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wird auf diesem Gerät noch vorbereitet. Versuche es in ein paar Minuten erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence προετοιμάζεται ακόμα σε αυτήν τη συσκευή. Δοκίμασε ξανά σε λίγα λεπτά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún se está preparando en este dispositivo. Inténtalo de nuevo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est encore en cours de préparation sur cet appareil. Réessayez dans quelques minutes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è ancora in preparazione su questo dispositivo. Riprova tra qualche minuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceはこのデバイスでまだ準備中です。数分後にもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 아직 이 기기에서 준비 중입니다. 몇 분 후에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence ainda está sendo preparada neste dispositivo. Tente novamente em alguns minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ещё готовится к работе на этом устройстве. Повторите попытку через несколько минут."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ще готується до роботи на цьому пристрої. Повторіть спробу за кілька хвилин."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 仍在此裝置上準備中。請幾分鐘後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 仍在此设备上准备中。请几分钟后再试。"
          }
        }
      }
    },
    "Apple Intelligence is turned off. Enable it in Settings to use the built-in model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert. Aktiviere es in den Einstellungen, um das integrierte Modell zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence είναι απενεργοποιημένο. Ενεργοποίησέ το στις Ρυθμίσεις για να χρησιμοποιήσεις το ενσωματωμένο μοντέλο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado. Actívalo en Ajustes para usar el modelo integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé. Activez-le dans Réglages pour utiliser le modèle intégré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivato. Attivalo in Impostazioni per usare il modello integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがオフになっています。内蔵モデルを使うには設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. 내장 모델을 사용하려면 설정에서 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence está desativada. Ative-a nos Ajustes para usar o modelo integrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence выключен. Включите его в Настройках, чтобы использовать встроенную модель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence вимкнено. Увімкніть його в Налаштуваннях, щоб використовувати вбудовану модель."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已關閉。請在設定中開啟，以使用內置模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已关闭。请在设置中开启以使用内置模型。"
          }
        }
      }
    },
    "Apple Intelligence isn't ready. Choose a downloaded model in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist nicht bereit. Wähle in den Einstellungen ein geladenes Modell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence δεν είναι έτοιμο. Διάλεξε στις Ρυθμίσεις ένα μοντέλο που έχει ληφθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está listo. Elige un modelo descargado en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n'est pas prêt. Choisissez un modèle téléchargé dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence non è pronto. Scegli un modello scaricato in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceの準備ができていません。設定でダウンロード済みのモデルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 준비되지 않았습니다. 설정에서 다운로드된 모델을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence não está pronta. Escolha um modelo baixado nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence не готов. Выберите скачанную модель в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence не готовий. Виберіть завантажену модель у Налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 尚未就緒。請在設定中選擇已下載的模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 尚未就绪。请在设置中选择已下载的模型。"
          }
        }
      }
    },
