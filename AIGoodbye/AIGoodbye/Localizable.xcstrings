    "That took too long to answer. Try a shorter question, or ask in the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort hat zu lange gedauert. Versuche eine kürzere Frage oder frage in der App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντηση άργησε πολύ. Δοκίμασε πιο σύντομη ερώτηση ή ρώτησε μέσα στην εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta tardó demasiado. Prueba con una pregunta más corta o pregúntalo en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse a pris trop de temps. Essayez une question plus courte ou posez-la dans l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta ha richiesto troppo tempo. Prova con una domanda più breve o chiedi nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答に時間がかかりすぎました。もっと短い質問にするか、アプリ内で質問してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 너무 오래 걸렸습니다. 더 짧은 질문을 하거나 앱에서 물어보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta demorou demais. Tente uma pergunta mais curta ou pergunte no app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ занял слишком много времени. Задайте вопрос покороче или спросите в приложении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь зайняла надто багато часу. Поставте коротше запитання або запитайте в застосунку."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "回答耗時過長。請換一個更簡短的問題，或在 App 中提問。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答用时过长。请换一个更简短的问题，或在 App 中提问。"
          }
        }
      }
    },
    "The AI is busy with another task. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI ist gerade mit etwas anderem beschäftigt. Versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AI είναι απασχολημένο με άλλη εργασία. Δοκίμασε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA está ocupada con otra tarea. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA est occupée par une autre tâche. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA è occupata con un'altra attività. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI は別の処理を実行中です。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 다른 작업을 처리 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA está ocupada com outra tarefa. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ занят другой задачей. Повторите попытку через мгновение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ зайнятий іншим завданням. Спробуйте ще раз за мить."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 正在處理其他任務。請稍後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 正在处理其他任务。请稍后再试。"
          }
        }
      }
    },
    "The AI model isn't ready yet. Download or select a model in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
