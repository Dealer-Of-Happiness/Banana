        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 AI 都在您的设备上运行"
          }
        }
      }
    },
    "All messages in this conversation will be deleted. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Nachrichten in dieser Unterhaltung werden gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα μηνύματα σε αυτήν τη συζήτηση θα διαγραφούν. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los mensajes de esta conversación. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les messages de cette conversation seront supprimés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i messaggi di questa conversazione verranno eliminati. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話のすべてのメッセージが削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화의 모든 메시지가 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as mensagens desta conversa serão apagadas. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сообщения в этой беседе будут удалены. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі повідомлення в цій розмові буде видалено. Цю дію не можна скасувати."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話中的所有訊息都會被刪除。此操作無法復原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话中的所有消息都将被删除。此操作无法撤销。"
          }
        }
      }
    },
    "All remembered notes will be deleted from this device. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gemerkten Notizen werden von diesem Gerät gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι αποθηκευμένες σημειώσεις θα διαγραφούν από αυτή τη συσκευή. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las notas recordadas se eliminarán de este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les notes mémorisées seront supprimées de cet appareil. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le note memorizzate verranno eliminate da questo dispositivo. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶しているメモはすべて、このデバイスから削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억한 메모가 모두 이 기기에서 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as notas lembradas serão apagadas deste dispositivo. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все запомненные заметки будут удалены с этого устройства. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі запам'ятовані нотатки буде видалено з цього пристрою. Цю дію не можна скасувати."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有記住嘅內容都會喺呢部裝置刪除。此操作無法復原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有记住的内容都将从此设备上删除。此操作无法撤销。"
          }
        }
      }
    },
