      }
    },
    "Restores every setting to its default value. Your conversations are not affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt alle Einstellungen auf ihre Standardwerte zurück. Ihre Unterhaltungen sind davon nicht betroffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφέρει κάθε ρύθμιση στην προεπιλεγμένη τιμή της. Οι συζητήσεις σας δεν επηρεάζονται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restablece todos los ajustes a sus valores predeterminados. Tus conversaciones no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit la valeur par défaut de chaque réglage. Vos conversations ne sont pas affectées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riporta ogni impostazione al valore predefinito. Le tue conversazioni non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての設定をデフォルト値に戻します。会話には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 설정을 기본값으로 복원합니다. 대화는 영향을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura todos os ajustes para os valores padrão. Suas conversas não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возвращает все настройки к значениям по умолчанию. Ваши беседы не затрагиваются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повертає всі налаштування до стандартних значень. Ваші розмови залишаться без змін."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有設定回復為預設值。你的對話不會受影響。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将所有设置恢复为默认值。您的对话不受影响。"
          }
        }
      }
    },
