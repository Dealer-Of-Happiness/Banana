    "Up to %lld documents can be switched on at once, so answers stay fast.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es können bis zu %lld Dokumente gleichzeitig aktiv sein, damit Antworten schnell bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορούν να είναι ενεργά έως %lld έγγραφα ταυτόχρονα, ώστε οι απαντήσεις να παραμένουν γρήγορες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se pueden activar hasta %lld documentos a la vez para que las respuestas sigan siendo rápidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à %lld documents peuvent être activés en même temps, afin que les réponses restent rapides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Possono essere attivi fino a %lld documenti alla volta, così le risposte restano veloci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同時にオンにできる書類は最大 %lld 件です。回答の速さを保つためです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 최대 %lld개의 문서를 켤 수 있습니다. 답변 속도를 유지하기 위해서입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É possível ativar até %lld documentos ao mesmo tempo para que as respostas continuem rápidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно можно включить до %lld документов, чтобы ответы оставались быстрыми."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одночасно можна ввімкнути до %lld документів, щоб відповіді залишалися швидкими."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可同時啟用 %lld 個文件，以保持回答速度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多可同时启用 %lld 个文稿，以保持回答速度。"
          }
        }
      }
    },
