          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати це фото. Спробуйте інше."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取此相片。請試試另一張。"
