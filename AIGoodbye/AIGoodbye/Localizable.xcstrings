    "No internet connection. The model download needs internet once; chatting works fully offline afterward.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung. Das Laden des Modells benötigt einmalig Internet; danach funktioniert das Chatten vollständig offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión a internet. La descarga del modelo necesita internet una sola vez; después, el chat funciona totalmente sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de connexion internet. Le téléchargement du modèle nécessite internet une seule fois ; ensuite, la discussion fonctionne entièrement hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione a internet. Il download del modello richiede internet una sola volta; dopo, la chat funziona completamente offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットに接続されていません。モデルのダウンロードには一度だけインターネットが必要です。その後のチャットは完全にオフラインで動作します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão com a internet. O download do modelo precisa de internet uma vez; depois disso, o chat funciona totalmente offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к интернету. Для скачивания модели интернет нужен один раз; после этого чат работает полностью офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无互联网连接。下载模型只需联网一次，之后聊天完全离线进行。"
          }
        }
      }
    },
