    "Models download once and then work fully offline. You can delete them anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle werden einmal geladen und funktionieren danach vollständig offline. Sie können sie jederzeit in den Einstellungen löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μοντέλα λαμβάνονται μία φορά και μετά λειτουργούν πλήρως εκτός σύνδεσης. Μπορείτε να τα διαγράψετε οποτεδήποτε στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos se descargan una sola vez y luego funcionan totalmente sin conexión. Puedes eliminarlos cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles se téléchargent une seule fois, puis fonctionnent entièrement hors ligne. Vous pouvez les supprimer à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli si scaricano una sola volta e poi funzionano completamente offline. Puoi eliminarli in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは一度ダウンロードすれば、その後は完全にオフラインで動作します。設定でいつでも削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델은 한 번만 다운로드하면 이후 완전히 오프라인으로 작동합니다. 설정에서 언제든지 삭제할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos são baixados uma vez e depois funcionam totalmente offline. Você pode apagá-los a qualquer momento nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели скачиваются один раз и затем работают полностью офлайн. Их можно удалить в любой момент в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделі завантажуються один раз і далі працюють повністю офлайн. Їх можна будь-коли видалити в Налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "模型只需下載一次，之後就可以完全離線使用。你可以隨時在設定中刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型只需下载一次，之后即可完全离线使用。您可以随时在设置中删除。"
          }
        }
      }
    },
