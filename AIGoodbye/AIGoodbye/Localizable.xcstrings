    "Built into your device - instant, no download": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dein Gerät integriert – sofort, ohne Download"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενσωματωμένο στη συσκευή σας — άμεσο, χωρίς λήψη"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrado en tu dispositivo: instantáneo, sin descargas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intégré à votre appareil — instantané, sans téléchargement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrato nel tuo dispositivo: istantaneo, senza download"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスに内蔵 — 即座に使え、ダウンロード不要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 내장 - 즉시 사용, 다운로드 불필요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrado ao seu dispositivo: instantâneo, sem download"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроено в ваше устройство — мгновенно, без загрузки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудовано у ваш пристрій — миттєво, без завантаження"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "內置喺你部裝置——即刻用得，唔使下載"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置于您的设备——即时可用，无需下载"
          }
        }
      }
    },
    "By continuing you agree to use AiGoodbye at your own discretion.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indem Sie fortfahren, erklären Sie sich damit einverstanden, AiGoodbye nach eigenem Ermessen zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίζοντας, συμφωνείτε να χρησιμοποιείτε το AiGoodbye κατά την κρίση σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas usar AiGoodbye bajo tu propio criterio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez d'utiliser AiGoodbye à votre propre discrétion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando, accetti di usare AiGoodbye a tua discrezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行すると、ご自身の判断でAiGoodbyeを使用することに同意したことになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 AiGoodbye를 본인의 판단에 따라 사용하는 데 동의하는 것입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, você concorda em usar o AiGoodbye a seu próprio critério."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжая, вы соглашаетесь использовать AiGoodbye на своё усмотрение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуючи, ви погоджуєтеся використовувати AiGoodbye на власний розсуд."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續即表示你同意自行斟酌使用 AiGoodbye。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即表示您同意自行斟酌使用 AiGoodbye。"
          }
        }
      }
    },
