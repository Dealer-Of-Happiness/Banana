            "value": "该模型已内置，请在模型列表中选择。"
          }
        }
      }
    },
    "That text is too long to translate in one go. Split it into shorter parts and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Text ist zu lang, um ihn auf einmal zu übersetzen. Teile ihn in kürzere Abschnitte und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το κείμενο είναι πολύ μεγάλο για να μεταφραστεί με τη μία. Χώρισέ το σε μικρότερα κομμάτια και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese texto es demasiado largo para traducirlo de una vez. Divídelo en partes más cortas e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce texte est trop long pour être traduit en une seule fois. Divisez-le en parties plus courtes et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo testo è troppo lungo da tradurre in una volta. Dividilo in parti più brevi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテキストは長すぎて一度に翻訳できません。短く分けてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트가 너무 길어 한 번에 번역할 수 없습니다. 더 짧게 나눈 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse texto é longo demais para traduzir de uma vez. Divida-o em partes menores e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот текст слишком длинный, чтобы перевести его за один раз. Разделите его на части покороче и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей текст задовгий, щоб перекласти його за один раз. Розділіть його на коротші частини й спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢段文字太長，冇辦法一次過翻譯。分成短啲嘅幾段再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段文本太长，无法一次翻译。请拆成较短的部分后重试。"
          }
        }
      }
    },
    "That took too long to answer. Try a shorter question, or ask in the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort hat zu lange gedauert. Versuche eine kürzere Frage oder frage in der App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντηση άργησε πολύ. Δοκίμασε πιο σύντομη ερώτηση ή ρώτησε μέσα στην εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta tardó demasiado. Prueba con una pregunta más corta o pregúntalo en la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse a pris trop de temps. Essayez une question plus courte ou posez-la dans l'app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta ha richiesto troppo tempo. Prova con una domanda più breve o chiedi nell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答に時間がかかりすぎました。もっと短い質問にするか、アプリ内で質問してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 너무 오래 걸렸습니다. 더 짧은 질문을 하거나 앱에서 물어보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta demorou demais. Tente uma pergunta mais curta ou pergunte no app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ занял слишком много времени. Задайте вопрос покороче или спросите в приложении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь зайняла надто багато часу. Поставте коротше запитання або запитайте в застосунку."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "回答耗時過長。請換一個更簡短的問題，或在 App 中提問。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答用时过长。请换一个更简短的问题，或在 App 中提问。"
          }
        }
      }
    },
    "The AI is busy with another task. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI ist gerade mit etwas anderem beschäftigt. Versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AI είναι απασχολημένο με άλλη εργασία. Δοκίμασε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA está ocupada con otra tarea. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA est occupée par une autre tâche. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA è occupata con un'altra attività. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI は別の処理を実行中です。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 다른 작업을 처리 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA está ocupada com outra tarefa. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ занят другой задачей. Повторите попытку через мгновение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ зайнятий іншим завданням. Спробуйте ще раз за мить."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 正在處理其他任務。請稍後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 正在处理其他任务。请稍后再试。"
          }
        }
      }
    },
    "The AI model isn't ready yet. Download or select a model in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Modell ist noch nicht bereit. Lade oder wähle ein Modell in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο AI δεν είναι έτοιμο ακόμα. Κάνε λήψη ή διάλεξε ένα μοντέλο στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de IA aún no está listo. Descarga o selecciona un modelo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'IA n'est pas encore prêt. Téléchargez ou sélectionnez un modèle dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello IA non è ancora pronto. Scarica o seleziona un modello in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIモデルの準備がまだできていません。設定でモデルをダウンロードまたは選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 모델이 아직 준비되지 않았습니다. 설정에서 모델을 다운로드하거나 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de IA ainda não está pronto. Baixe ou selecione um modelo nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ИИ ещё не готова. Скачайте или выберите модель в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ШІ ще не готова. Завантажте або виберіть модель у Налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 模型尚未就緒。請在設定中下載或選擇模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 模型尚未就绪。请在设置中下载或选择模型。"
          }
        }
      }
    },
    "The AI runs on this device. Nothing you type is ever uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI läuft auf diesem Gerät. Nichts, was du eingibst, wird jemals hochgeladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AI τρέχει σε αυτή τη συσκευή. Τίποτα από όσα γράφεις δεν ανεβαίνει ποτέ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA se ejecuta en este dispositivo. Nada de lo que escribes se sube nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA fonctionne sur cet appareil. Rien de ce que vous écrivez n'est jamais envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA gira su questo dispositivo. Nulla di ciò che scrivi viene mai caricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI はこの端末で動作します。入力した内容がアップロードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI는 이 기기에서 실행됩니다. 입력한 내용이 업로드되는 일은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA roda neste dispositivo. Nada do que você digita é enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ работает на этом устройстве. Ничего из введённого вами не загружается в сеть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ працює на цьому пристрої. Нічого з введеного вами не завантажується в мережу."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 在本裝置上執行。你輸入的任何內容都不會被上傳。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 在本设备上运行。你输入的任何内容都不会被上传。"
          }
        }
      }
    },
    "The answer was stopped because the app went to the background. Tap Try Again to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Antwort wurde abgebrochen, weil die App in den Hintergrund ging. Tippe auf „Erneut versuchen“, um fortzufahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απάντηση διακόπηκε επειδή η εφαρμογή πήγε στο παρασκήνιο. Πάτησε «Δοκιμή ξανά» για να συνεχίσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The answer was stopped because the app went to the background. Tap Try Again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La respuesta se detuvo porque la app pasó a segundo plano. Toca Reintentar para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réponse a été interrompue, car l'app est passée en arrière-plan. Touchez Réessayer pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta è stata interrotta perché l'app è passata in background. Tocca Riprova per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがバックグラウンドに移動したため回答を停止しました。続けるには「再試行」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 백그라운드로 전환되어 답변이 중단되었습니다. 계속하려면 다시 시도를 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta foi interrompida porque o app foi para segundo plano. Toque em Tentar novamente para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ прерван: приложение ушло в фон. Нажмите «Повторить», чтобы продолжить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь перервано: застосунок перейшов у фон. Натисніть «Повторити», щоб продовжити."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "App 轉入背景，回答已停止。點一下「再試一次」繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用转入后台，回答已停止。点按“重试”继续。"
          }
        }
      }
    },
    "The app asks for the camera, microphone and speech recognition only when you use those features, and works fully without them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App fragt nur dann nach Kamera, Mikrofon und Spracherkennung, wenn du diese Funktionen nutzt – und funktioniert auch ganz ohne sie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή ζητά κάμερα, μικρόφωνο και αναγνώριση ομιλίας μόνο όταν χρησιμοποιείς αυτές τις λειτουργίες, και δουλεύει κανονικά και χωρίς αυτές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app pide la cámara, el micrófono y el reconocimiento de voz solo cuando usas esas funciones, y funciona perfectamente sin ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app demande l'accès à la caméra, au micro et à la reconnaissance vocale uniquement quand vous utilisez ces fonctions, et fonctionne parfaitement sans elles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app chiede fotocamera, microfono e riconoscimento vocale solo quando usi queste funzioni, e funziona benissimo anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ、マイク、音声認識の許可を求めるのは、それらの機能を使うときだけです。なくてもアプリは問題なく使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 카메라, 마이크, 음성 인식을 해당 기능을 사용할 때만 요청하며, 없어도 아무 문제 없이 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app pede câmera, microfone e reconhecimento de fala só quando você usa esses recursos, e funciona muito bem sem eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение запрашивает камеру, микрофон и распознавание речи только тогда, когда вы пользуетесь этими функциями, и полностью работает без них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок запитує камеру, мікрофон і розпізнавання мовлення лише тоді, коли ви користуєтеся цими функціями, і повністю працює без них."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只有喺你用相機、麥克風同語音辨識嘅時候，應用程式先會要求權限；冇咗佢哋，一樣用得晒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在你使用相机、麦克风和语音识别这些功能时，应用才会请求相应权限；没有它们，应用也能完整使用。"
          }
        }
      }
    },
    "The audio couldn't be saved to the end (the device may be out of space), but the transcript is complete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio konnte nicht bis zum Ende gesichert werden (möglicherweise ist der Speicher voll), das Transkript ist aber vollständig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος δεν αποθηκεύτηκε μέχρι το τέλος (ίσως δεν υπάρχει χώρος στη συσκευή), αλλά η απομαγνητοφώνηση είναι πλήρης."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio no se pudo guardar hasta el final (puede que el dispositivo no tenga espacio), pero la transcripción está completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio n'a pas pu être enregistré jusqu'au bout (l'appareil manque peut-être d'espace), mais la transcription est complète."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare l'audio fino alla fine (il dispositivo potrebbe non avere spazio), ma la trascrizione è completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声を最後まで保存できませんでした（端末の空き容量が不足している可能性があります）。文字起こしは完全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오를 끝까지 저장하지 못했습니다(기기 저장 공간이 부족할 수 있습니다). 텍스트 기록은 완전합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o áudio até o fim (o dispositivo pode estar sem espaço), mas a transcrição está completa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук не удалось сохранить до конца (возможно, на устройстве нет места), но расшифровка полная."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук не вдалося зберегти до кінця (можливо, на пристрої немає місця), але розшифровка повна."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊未能保存到最後（裝置可能空間不足），但文字記錄是完整的。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频未能保存到最后（设备可能空间不足），但文字记录是完整的。"
          }
        }
      }
    },
    "The audio couldn't be saved to the end. The device may be out of space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio konnte nicht bis zum Ende gesichert werden. Möglicherweise ist der Speicher voll."
          }
        },
        "el": {
