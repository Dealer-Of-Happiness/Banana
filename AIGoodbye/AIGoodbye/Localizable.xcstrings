    "%@ is already on this device but couldn't be loaded last time. Try again, or choose another model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits auf diesem Gerät, konnte beim letzten Mal aber nicht geladen werden. Versuche es erneut oder wähle ein anderes Modell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ υπάρχει ήδη σε αυτή τη συσκευή, αλλά δεν φορτώθηκε την τελευταία φορά. Δοκίμασε ξανά ή διάλεξε άλλο μοντέλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already on this device but couldn't be loaded last time. Try again, or choose another model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está en este dispositivo, pero no se pudo cargar la última vez. Inténtalo de nuevo o elige otro modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà sur cet appareil mais n'a pas pu être chargé la dernière fois. Réessayez ou choisissez un autre modèle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già su questo dispositivo ma l'ultima volta non è stato possibile caricarlo. Riprova o scegli un altro modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はすでにこのデバイスにありますが、前回は読み込めませんでした。もう一度試すか、別のモデルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이미 이 기기에 있지만 지난번에 불러오지 못했습니다. 다시 시도하거나 다른 모델을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ já está neste aparelho, mas não pôde ser carregado da última vez. Tente novamente ou escolha outro modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже на этом устройстве, но в прошлый раз его не удалось загрузить. Попробуйте ещё раз или выберите другую модель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ уже на цьому пристрої, але минулого разу його не вдалося завантажити. Спробуйте ще раз або виберіть іншу модель."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已經喺此裝置上，但上次未能載入。請再試一次，或揀另一個模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在此设备上，但上次未能加载。请重试，或选择其他模型。"
          }
        }
      }
    },
    "%@ needs to be downloaded first.": {
