    "To chat privately on this device, %1$@ (%2$@) needs to be downloaded once. After that, everything works offline.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um auf diesem Gerät privat zu chatten, muss %1$@ (%2$@) einmal geladen werden. Danach funktioniert alles offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para chatear de forma privada en este dispositivo, es necesario descargar %1$@ (%2$@) una sola vez. Después, todo funciona sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour discuter en privé sur cet appareil, %1$@ (%2$@) doit être téléchargé une seule fois. Ensuite, tout fonctionne hors ligne."
