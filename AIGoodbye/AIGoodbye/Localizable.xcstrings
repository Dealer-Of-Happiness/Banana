    "Built-in personas can't be changed. Make a copy to adjust one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrierte Personas können nicht geändert werden. Erstelle eine Kopie, um eine anzupassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ενσωματωμένοι χαρακτήρες δεν αλλάζουν. Δημιούργησε ένα αντίγραφο για να τον προσαρμόσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las personalidades integradas no se pueden cambiar. Haz una copia para ajustarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnalités intégrées ne peuvent pas être modifiées. Faites-en une copie pour l'ajuster."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le personalità integrate non si possono modificare. Crea una copia per personalizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵のペルソナは変更できません。調整するにはコピーを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 페르소나는 변경할 수 없습니다. 조정하려면 사본을 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As personalidades integradas não podem ser alteradas. Faça uma cópia para ajustá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенные роли нельзя изменить. Создайте копию, чтобы настроить её."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудовані ролі не можна змінити. Створіть копію, щоб налаштувати її."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "內置角色唔可以改。製作副本就可以調整。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置角色无法更改。制作副本即可调整。"
          }
        }
      }
    },
    "By continuing you agree to use AiGoodbye at your own discretion.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Indem du fortfährst, erklärst du dich damit einverstanden, AiGoodbye nach eigenem Ermessen zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνεχίζοντας, συμφωνείς να χρησιμοποιείς το AiGoodbye κατά την κρίση σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al continuar, aceptas usar AiGoodbye bajo tu propio criterio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En continuant, vous acceptez d'utiliser AiGoodbye à votre propre discrétion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuando, accetti di usare AiGoodbye a tua discrezione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行すると、ご自身の判断でAiGoodbyeを使用することに同意したことになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하면 AiGoodbye를 본인의 판단에 따라 사용하는 데 동의하는 것입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao continuar, você concorda em usar o AiGoodbye a seu próprio critério."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжая, вы соглашаетесь использовать AiGoodbye на своё усмотрение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжуючи, ви погоджуєтеся використовувати AiGoodbye на власний розсуд."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "繼續即表示你同意自行斟酌使用 AiGoodbye。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续即表示你同意自行斟酌使用 AiGoodbye。"
          }
        }
      }
    },
