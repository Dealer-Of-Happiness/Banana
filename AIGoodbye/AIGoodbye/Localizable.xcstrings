    "Deleting a model frees space immediately. It will be downloaded again the next time you use it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Löschen eines Modells gibt sofort Speicherplatz frei. Es wird beim nächsten Gebrauch erneut geladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η διαγραφή ενός μοντέλου ελευθερώνει χώρο αμέσως. Θα ληφθεί ξανά την επόμενη φορά που θα το χρησιμοποιήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar un modelo libera espacio de inmediato. Se volverá a descargar la próxima vez que lo uses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un modèle libère immédiatement de l'espace. Il sera téléchargé à nouveau lors de sa prochaine utilisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare un modello libera subito spazio. Verrà scaricato di nuovo al prossimo utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを削除するとすぐに空き容量が増えます。次回使用時に再度ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 삭제하면 공간이 즉시 확보됩니다. 다음에 사용할 때 다시 다운로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar um modelo libera espaço imediatamente. Ele será baixado de novo na próxima vez que você usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление модели сразу освобождает место. Она будет скачана снова при следующем использовании."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалення моделі одразу звільняє місце. Її буде завантажено знову під час наступного використання."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除模型可立即釋放空間。下次使用時會再次下載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除模型会立即释放空间。下次使用时将重新下载。"
          }
        }
      }
    },
