    "AiGoodbye": {
      "shouldTranslate": false
    },
    "AiGoodbye is a one-time purchase. There are no subscriptions and no hidden fees - pay once and it is yours.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ist ein Einmalkauf. Es gibt keine Abos und keine versteckten Kosten – einmal zahlen, und die App gehört Ihnen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye είναι μια εφάπαξ αγορά. Δεν υπάρχουν συνδρομές ούτε κρυφές χρεώσεις – πληρώνετε μία φορά και είναι δικό σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye es una compra única. No hay suscripciones ni cargos ocultos: pagas una vez y la app es tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye est un achat unique. Pas d'abonnement ni de frais cachés : vous payez une fois et l'app est à vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye è un acquisto una tantum. Nessun abbonamento e nessun costo nascosto: paghi una volta e l'app è tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは買い切りアプリです。サブスクリプションも隠れた料金もありません。一度支払えば、ずっとあなたのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 한 번만 구입하면 되는 앱입니다. 구독도 숨겨진 요금도 없습니다. 한 번 결제하면 평생 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye é uma compra única. Não há assinaturas nem taxas ocultas: você paga uma vez e o app é seu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye — это разовая покупка. Никаких подписок и скрытых платежей: заплатите один раз, и приложение ваше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye — це разова покупка. Жодних підписок і прихованих платежів: заплатіть один раз, і застосунок ваш."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 是一次性買斷的應用程式。沒有訂閱，亦沒有隱藏收費——畀一次錢，就永遠屬於你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 是一次性买断的应用。没有订阅，也没有隐藏费用——付款一次，永久使用。"
          }
        }
      }
    },
    "AiGoodbye is busy with another task. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ist mit einer anderen Aufgabe beschäftigt. Versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye είναι απασχολημένο με άλλη εργασία. Δοκίμασε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye está ocupado con otra tarea. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye est occupé par une autre tâche. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye è occupato con un'altra attività. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye は別の処理を実行中です。少し待ってからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye가 다른 작업을 처리 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye está ocupado com outra tarefa. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye занят другой задачей. Повторите попытку через мгновение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye зайнятий іншим завданням. Спробуйте ще раз за мить."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 正在處理其他任務。請稍後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 正在处理其他任务。请稍后再试。"
          }
        }
      }
    },
    "AiGoodbye is locked. Open the app and unlock it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ist gesperrt. Öffne die App und entsperre sie zuerst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye είναι κλειδωμένο. Άνοιξε την εφαρμογή και ξεκλείδωσέ την πρώτα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye está bloqueado. Abre la app y desbloquéala primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye est verrouillé. Ouvrez l'app et déverrouillez-la d'abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye è bloccato. Apri l'app e sbloccala prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye はロックされています。先にアプリを開いてロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye가 잠겨 있습니다. 먼저 앱을 열어 잠금을 해제하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye está bloqueado. Abra o app e desbloqueie primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye заблокирован. Откройте приложение и разблокируйте его."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye заблоковано. Відкрийте застосунок і розблокуйте його."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 已鎖定。請先開啟 App 並解鎖。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 已锁定。请先打开 App 并解锁。"
          }
        }
      }
    },
    "AiGoodbye needs microphone access for voice conversations. You can enable it in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye braucht Zugriff auf das Mikrofon für Sprachgespräche. Du kannst ihn in der Einstellungen-App erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρειάζεται πρόσβαση στο μικρόφωνο για φωνητικές συνομιλίες. Μπορείς να την ενεργοποιήσεις στην εφαρμογή Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye necesita acceso al micrófono para las conversaciones por voz. Puedes activarlo en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye a besoin d'accéder au micro pour les conversations vocales. Vous pouvez l'autoriser dans l'app Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ha bisogno dell'accesso al microfono per le conversazioni vocali. Puoi attivarlo nell'app Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声会話にはAiGoodbyeがマイクにアクセスする必要があります。設定アプリで許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 대화를 하려면 AiGoodbye에 마이크 접근 권한이 필요합니다. 설정 앱에서 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye precisa de acesso ao microfone para conversas por voz. Você pode ativá-lo no app Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосовых разговоров AiGoodbye нужен доступ к микрофону. Его можно включить в приложении «Настройки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосових розмов AiGoodbye потрібен доступ до мікрофона. Його можна увімкнути в застосунку «Параметри»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "語音對話需要 AiGoodbye 取用麥克風。你可以喺「設定」App 入面開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音对话需要 AiGoodbye 访问麦克风。你可以在“设置”App 中开启。"
          }
        }
      }
    },
    "AiGoodbye needs microphone access to record. You can enable it in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye benötigt Zugriff auf das Mikrofon, um aufzunehmen. Du kannst ihn in der App „Einstellungen“ aktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρειάζεται πρόσβαση στο μικρόφωνο για να ηχογραφεί. Μπορείς να την ενεργοποιήσεις στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye necesita acceso al micrófono para grabar. Puedes activarlo en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye a besoin d'accéder au micro pour enregistrer. Vous pouvez l'autoriser dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ha bisogno dell'accesso al microfono per registrare. Puoi attivarlo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するには、AiGoodbye にマイクへのアクセスが必要です。「設定」アプリで許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하려면 AiGoodbye에 마이크 권한이 필요합니다. 설정 앱에서 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye precisa de acesso ao microfone para gravar. Você pode ativar nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для записи AiGoodbye нужен доступ к микрофону. Включить его можно в приложении «Настройки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для запису AiGoodbye потрібен доступ до мікрофона. Увімкнути його можна в застосунку «Параметри»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 需要麥克風權限才能錄音。你可以在「設定」中開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 需要麦克风权限才能录音。你可以在“设置”中开启。"
          }
        }
      }
    },
    "AiGoodbye stopped while a recording was in progress. What was captured up to that point can be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye wurde während einer laufenden Aufnahme beendet. Was bis dahin aufgezeichnet wurde, lässt sich sichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye σταμάτησε ενώ γινόταν εγγραφή. Ό,τι καταγράφηκε μέχρι εκείνη τη στιγμή μπορεί να αποθηκευτεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye se detuvo mientras había una grabación en curso. Lo capturado hasta ese momento se puede guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye s'est arrêté pendant un enregistrement. Ce qui a été capté jusque-là peut être conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye si è interrotta durante una registrazione. Quanto acquisito fino a quel momento può essere salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中にAiGoodbyeが停止しました。そこまでに記録された内容は保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중에 AiGoodbye가 중단됐습니다. 그때까지 기록된 내용은 저장할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye parou durante uma gravação. O que foi captado até ali pode ser salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye остановился во время записи. Всё, что записано до этого момента, можно сохранить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye зупинився під час запису. Усе, що записано до цього моменту, можна зберегти."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 喺錄音途中停咗。之前錄到嘅內容可以保存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 在录音过程中停止了。此前录到的内容可以保存。"
          }
        }
      }
    },
    "All AI runs directly on your device, and your conversations never leave it. There are no servers, no accounts, no tracking, and no data collection. What you talk about stays yours.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesamte KI läuft direkt auf deinem Gerät, und deine Unterhaltungen verlassen es nie. Keine Server, keine Konten, kein Tracking, keine Datensammlung. Worüber du sprichst, bleibt deins."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλο το AI τρέχει απευθείας στη συσκευή σας και οι συνομιλίες σας δεν τη φεύγουν ποτέ. Χωρίς διακομιστές, λογαριασμούς, παρακολούθηση ή συλλογή δεδομένων. Ό,τι συζητάτε μένει δικό σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda la IA funciona directamente en tu dispositivo y tus conversaciones nunca salen de él. No hay servidores, ni cuentas, ni rastreo, ni recopilación de datos. De lo que hablas, es tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute l'IA fonctionne directement sur votre appareil et vos conversations ne le quittent jamais. Pas de serveurs, pas de comptes, pas de suivi, pas de collecte de données. Ce dont vous parlez reste à vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta l'IA funziona direttamente sul tuo dispositivo e le tue conversazioni non lo lasciano mai. Niente server, niente account, niente tracciamento, nessuna raccolta dati. Ciò di cui parli resta tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのAIはデバイス上で直接動作し、会話がデバイスから出ることはありません。サーバーもアカウントもトラッキングもデータ収集もありません。話した内容はあなたのものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 AI가 기기에서 직접 실행되며 대화는 절대 기기를 떠나지 않습니다. 서버도, 계정도, 추적도, 데이터 수집도 없습니다. 대화 내용은 온전히 당신의 것입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a IA roda diretamente no seu dispositivo e suas conversas nunca saem dele. Sem servidores, sem contas, sem rastreamento e sem coleta de dados. O que você conversa continua seu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь ИИ работает прямо на вашем устройстве, и ваши беседы никогда его не покидают. Нет серверов, аккаунтов, отслеживания и сбора данных. О чём вы говорите — остаётся вашим."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь ШІ працює прямо на вашому пристрої, і ваші розмови ніколи його не залишають. Жодних серверів, акаунтів, стеження чи збору даних. Те, про що ви говорите, залишається вашим."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 AI 都直接喺你部裝置上運行，對話絕對唔會離開裝置。冇伺服器、冇帳戶、冇追蹤、冇收集數據。你傾嘅嘢只屬於你。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 AI 都直接在您的设备上运行，对话绝不离开设备。没有服务器、没有账号、没有跟踪、没有数据收集。您聊的内容只属于您。"
          }
        }
      }
    },
    "All messages in this conversation will be deleted. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Nachrichten in dieser Unterhaltung werden gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλα τα μηνύματα σε αυτήν τη συζήτηση θα διαγραφούν. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán todos los mensajes de esta conversación. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les messages de cette conversation seront supprimés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i messaggi di questa conversazione verranno eliminati. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話のすべてのメッセージが削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화의 모든 메시지가 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as mensagens desta conversa serão apagadas. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сообщения в этой беседе будут удалены. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі повідомлення в цій розмові буде видалено. Цю дію не можна скасувати."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話中的所有訊息都會被刪除。此操作無法復原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话中的所有消息都将被删除。此操作无法撤销。"
          }
        }
      }
    },
    "All remembered notes will be deleted from this device. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle gemerkten Notizen werden von diesem Gerät gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Όλες οι αποθηκευμένες σημειώσεις θα διαγραφούν από αυτή τη συσκευή. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las notas recordadas se eliminarán de este dispositivo. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les notes mémorisées seront supprimées de cet appareil. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le note memorizzate verranno eliminate da questo dispositivo. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶しているメモはすべて、このデバイスから削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억한 메모가 모두 이 기기에서 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as notas lembradas serão apagadas deste dispositivo. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все запомненные заметки будут удалены с этого устройства. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі запам'ятовані нотатки буде видалено з цього пристрою. Цю дію не можна скасувати."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有記住嘅內容都會喺呢部裝置刪除。此操作無法復原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有记住的内容都将从此设备上删除。此操作无法撤销。"
          }
        }
      }
    },
