      }
    },
    "The camera isn't available. Check camera permission in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht verfügbar. Prüfe die Kameraberechtigung in der Einstellungen-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα δεν είναι διαθέσιμη. Έλεγξε την άδεια κάμερας στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible. Comprueba el permiso de cámara en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra n'est pas disponible. Vérifiez l'autorisation de la caméra dans l'app Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è disponibile. Controlla il permesso della fotocamera nell'app Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを利用できません。設定アプリでカメラの許可を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 사용할 수 없습니다. 설정 앱에서 카메라 권한을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não está disponível. Verifique a permissão da câmera no app Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Проверьте разрешение камеры в приложении «Настройки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Перевірте дозвіл камери в застосунку «Налаштування»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用唔到相機。請喺「設定」App度檢查相機權限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机不可用。请在「设置」应用中检查相机权限。"
          }
        }
      }
    },
    "The camera isn't sending any pictures. Close this screen and open it again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera liefert keine Bilder. Schließe diesen Bildschirm und öffne ihn erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα δεν στέλνει εικόνες. Κλείσε αυτή την οθόνη και άνοιξέ την ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está enviando imágenes. Cierra esta pantalla y vuelve a abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo n'envoie aucune image. Fermez cet écran et rouvrez-le."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non invia immagini. Chiudi questa schermata e riaprila."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラから映像が届いていません。この画面を閉じて開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라에서 화면이 오지 않습니다. 이 화면을 닫았다가 다시 여세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não está enviando imagens. Feche esta tela e abra novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера не передаёт изображение. Закройте этот экран и откройте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера не передає зображення. Закрийте цей екран і відкрийте знову."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "相機沒有傳回畫面。請關閉此畫面後重新開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机没有传回画面。请关闭此界面后重新打开。"
          }
        }
      }
    },
    "The camera paused because the device is too hot or busy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wurde pausiert, weil das Gerät zu heiß oder ausgelastet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα σταμάτησε προσωρινά επειδή η συσκευή είναι πολύ ζεστή ή απασχολημένη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se pausó porque el dispositivo está demasiado caliente u ocupado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo s'est mis en pause car l'appareil est trop chaud ou occupé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera si è messa in pausa perché il dispositivo è troppo caldo o occupato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスが高温または処理中のため、カメラが一時停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 너무 뜨겁거나 바빠서 카메라가 일시 중지되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera pausou porque o dispositivo está muito quente ou ocupado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера приостановлена: устройство перегрето или занято."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камеру призупинено: пристрій перегрітий або зайнятий."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置過熱或太忙，相機暫停咗。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备过热或繁忙，相机已暂停。"
          }
        }
      }
    },
    "The camera pauses while another app shares the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera pausiert, solange eine andere App den Bildschirm teilt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα σταματά προσωρινά όσο μια άλλη εφαρμογή μοιράζεται την οθόνη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se pausa mientras otra app comparte la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo est en pause tant qu'une autre app partage l'écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera resta in pausa mentre un'altra app condivide lo schermo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリが画面を共有している間、カメラは一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 화면을 함께 쓰는 동안 카메라가 일시 중지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera fica pausada enquanto outro app divide a tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера приостановлена, пока экран делит другое приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера призупинена, поки екран ділить інший застосунок."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 App 共用螢幕期間，相機會暫停。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 共享屏幕时，相机会暂停。"
          }
        }
      }
    },
    "The camera was paused by a system privacy setting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wurde durch eine System-Datenschutzeinstellung pausiert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα σταμάτησε προσωρινά από μια ρύθμιση απορρήτου του συστήματος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una configuración de privacidad del sistema pausó la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un réglage de confidentialité du système a mis l'appareil photo en pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'impostazione di privacy del sistema ha messo in pausa la fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのプライバシー設定により、カメラが一時停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 개인정보 보호 설정으로 카메라가 일시 중지되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ajuste de privacidade do sistema pausou a câmera."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера приостановлена системной настройкой конфиденциальности."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камеру призупинено системним налаштуванням приватності."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "系統私隱設定暫停咗相機。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统隐私设置已暂停相机。"
          }
        }
      }
    },
    "The camera was paused.": {
      "localizations": {
        "de": {
          "stringUnit": {
