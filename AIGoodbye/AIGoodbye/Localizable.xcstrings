          "stringUnit": {
            "state": "translated",
            "value": "In dein Gerät integriert – sofort, ohne Download"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενσωματωμένο στη συσκευή σας — άμεσο, χωρίς λήψη"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrado en tu dispositivo: instantáneo, sin descargas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intégré à votre appareil — instantané, sans téléchargement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrato nel tuo dispositivo: istantaneo, senza download"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスに内蔵 — 即座に使え、ダウンロード不要"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에 내장 - 즉시 사용, 다운로드 불필요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
