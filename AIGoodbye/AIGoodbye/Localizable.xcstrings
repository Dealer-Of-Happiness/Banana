    "Tap a language button and start speaking. The translation is spoken back automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen Sie auf eine Sprachtaste und sprechen Sie einfach los. Die Übersetzung wird automatisch vorgelesen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πατήστε ένα κουμπί γλώσσας και αρχίστε να μιλάτε. Η μετάφραση εκφωνείται αυτόματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un botón de idioma y empieza a hablar. La traducción se dice en voz alta automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un bouton de langue et commencez à parler. La traduction est lue à voix haute automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un pulsante della lingua e inizia a parlare. La traduzione viene letta ad alta voce in automatico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語のボタンをタップして話し始めてください。訳文は自動で読み上げられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 버튼을 누르고 말하기 시작하세요. 번역은 자동으로 음성으로 들려줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um botão de idioma e comece a falar. A tradução é falada de volta automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите кнопку языка и начните говорить. Перевод будет произнесён автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть кнопку мови й починайте говорити. Переклад буде озвучено автоматично."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "撳一下語言掣，跟住開始講嘢。譯文會自動讀返出嚟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按一个语言按钮，然后开始说话。译文会自动朗读出来。"
          }
        }
      }
    },
