    },
    "Speech recognition stopped before anything was heard. Tap to try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung wurde beendet, bevor etwas gehört wurde. Tippe, um es erneut zu versuchen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η αναγνώριση ομιλίας σταμάτησε πριν ακουστεί οτιδήποτε. Πάτησε για να δοκιμάσεις ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz se detuvo antes de oír nada. Toca para intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale s'est arrêtée avant d'avoir rien entendu. Touchez pour réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale si è interrotto prima di sentire qualcosa. Tocca per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も聞き取る前に音声認識が停止しました。タップしてやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 듣기 전에 음성 인식이 중단되었습니다. 탭하여 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala parou antes de ouvir qualquer coisa. Toque para tentar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи остановилось, ничего не услышав. Нажмите, чтобы попробовать снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення зупинилося, нічого не почувши. Торкніться, щоб спробувати ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "語音辨識喺聽到任何嘢之前就停咗。㩒一下再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音识别在听到任何内容之前就停止了。轻点以重试。"
          }
        }
      }
    },
