    "Turn on Airplane Mode, then come back and chat. Everything keeps working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie den Flugmodus ein, kommen Sie zurück und chatten Sie. Alles funktioniert weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε τη Λειτουργία πτήσης, επιστρέψτε και συνομιλήστε. Όλα συνεχίζουν να λειτουργούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa el Modo Avión, vuelve aquí y chatea. Todo sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le Mode Avion, revenez et discutez. Tout continue de fonctionner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Uso in aereo, poi torna qui e scrivi. Continua a funzionare tutto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機内モードをオンにしてから戻って話しかけてみてください。すべてそのまま動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에어플레인 모드를 켠 다음 돌아와서 대화해 보세요. 모든 기능이 그대로 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Modo Avião, volte aqui e converse. Tudo continua funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Авиарежим, затем вернитесь и продолжайте общаться. Всё продолжит работать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть Режим польоту, потім поверніться й спілкуйтеся. Усе працюватиме далі."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開咗飛行模式，然後返嚟傾。一切照樣運作。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开飞行模式，然后回来聊天。一切照常运作。"
          }
        }
      }
    },
