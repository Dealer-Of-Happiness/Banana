    "Open AiGoodbye once to set up an AI model, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne AiGoodbye einmal, um ein KI-Modell einzurichten, und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το AiGoodbye μία φορά για να ρυθμίσετε ένα μοντέλο AI και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AiGoodbye una vez para configurar un modelo de IA y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez AiGoodbye une fois pour configurer un modèle d'IA, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri AiGoodbye una volta per configurare un modello di IA, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeを一度開いてAIモデルを設定してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye를 한 번 열어 AI 모델을 설정한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o AiGoodbye uma vez para configurar um modelo de IA e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте AiGoodbye один раз, чтобы настроить модель ИИ, и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте AiGoodbye один раз, щоб налаштувати модель ШІ, і спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開一次 AiGoodbye 設定好 AI 模型，然後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开 AiGoodbye 设置 AI 模型，然后重试。"
          }
        }
      }
    },
