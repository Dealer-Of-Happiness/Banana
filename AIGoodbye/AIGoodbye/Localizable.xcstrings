  "strings": {
    "%@ - %@": {
      "shouldTranslate": false
    },
    "%@ can't run on this engine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann auf dieser Engine nicht ausgeführt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν μπορεί να εκτελεστεί σε αυτόν τον μηχανισμό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede ejecutarse en este motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas s'exécuter sur ce moteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può essere eseguito su questo motore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのエンジンでは実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이 엔진에서 실행할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode ser executado neste mecanismo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не может работать на этом движке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не може працювати на цьому рушії."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法在此引擎上執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法在此引擎上运行。"
          }
        }
      }
    },
    "%@ needs to be downloaded first.": {
