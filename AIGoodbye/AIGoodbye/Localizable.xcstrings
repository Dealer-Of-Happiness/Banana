    "The AI automatically replies in the language you write in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI antwortet automatisch in der Sprache, in der Sie schreiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η AI απαντά αυτόματα στη γλώσσα στην οποία γράφετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA responde automáticamente en el idioma en que escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA répond automatiquement dans la langue dans laquelle vous écrivez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA risponde automaticamente nella lingua in cui scrivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIはあなたが書いた言語で自動的に返信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI는 사용자가 쓰는 언어로 자동으로 답변합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA responde automaticamente no idioma em que você escreve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ автоматически отвечает на том языке, на котором вы пишете."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ШІ автоматично відповідає тією мовою, якою ви пишете."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 會自動以你輸入的語言回覆。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 会自动使用您所用的语言回复。"
          }
        }
      }
    },
    "The AI model isn't ready yet. Download or select a model in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Modell ist noch nicht bereit. Laden oder wählen Sie ein Modell in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο AI δεν είναι έτοιμο ακόμα. Κάντε λήψη ή επιλέξτε ένα μοντέλο στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de IA aún no está listo. Descarga o selecciona un modelo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'IA n'est pas encore prêt. Téléchargez ou sélectionnez un modèle dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
