    "There isn't enough free space to record. Free up some space and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht genug freier Speicher zum Aufnehmen vorhanden. Schaffe Platz und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετός ελεύθερος χώρος για εγγραφή. Ελευθέρωσε χώρο και δοκίμασε ξανά."
          }
        },
        "es": {
