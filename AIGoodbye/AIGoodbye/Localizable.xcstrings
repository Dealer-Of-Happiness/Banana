    "This permanently deletes all your chats and folders. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Ihre Chats und Ordner dauerhaft gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει οριστικά όλες τις συνομιλίες και τους φακέλους σας. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todos tus chats y carpetas. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement toutes vos conversations et tous vos dossiers. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina definitivamente tutte le tue chat e cartelle. Non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのチャットとフォルダが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 채팅과 폴더가 영구적으로 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga permanentemente todas as suas conversas e pastas. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит все ваши чаты и папки. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить усі ваші чати й папки. Цю дію не можна скасувати."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除你的所有聊天和檔案夾。此操作無法復原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除您的所有聊天和文件夹。此操作无法撤销。"
          }
        }
      }
    },
    "This photo couldn't be loaded. Try a different one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht geladen werden. Versuchen Sie ein anderes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η φόρτωση αυτής της φωτογραφίας. Δοκιμάστε μια διαφορετική."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar esta foto. Prueba con otra."
          }
        },
        "fr": {
