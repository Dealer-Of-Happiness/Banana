    "No answer was generated. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde keine Antwort erzeugt. Bitte versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν δημιουργήθηκε απάντηση. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se generó ninguna respuesta. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse n'a été générée. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna risposta generata. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答が生成されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 생성되지 않았습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma resposta foi gerada. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ не был сгенерирован. Попробуйте ещё раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь не згенеровано. Спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "冇產生到回覆。請再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未生成回答。请重试。"
          }
        }
      }
    },
    "No answer was produced. Tap Try Again, or rephrase the question.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde keine Antwort erzeugt. Tippe auf „Erneut versuchen“ oder formuliere die Frage anders."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν παράχθηκε απάντηση. Πάτησε «Δοκιμή ξανά» ή διατύπωσε την ερώτηση διαφορετικά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se generó ninguna respuesta. Toca Reintentar o reformula la pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune réponse n'a été produite. Touchez Réessayer ou reformulez la question."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stata prodotta alcuna risposta. Tocca Riprova oppure riformula la domanda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答が生成されませんでした。「再試行」をタップするか、質問を言い換えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 생성되지 않았습니다. 다시 시도를 탭하거나 질문을 바꿔 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma resposta foi produzida. Toque em “Tentar novamente” ou reformule a pergunta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответ не был получен. Нажмите «Повторить» или переформулируйте вопрос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідь не було створено. Торкніться «Повторити» або переформулюйте запитання."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "冇產生到答案。㩒「再試一次」，或者換個方式問。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未生成回答。请轻点“重试”或换个方式提问。"
          }
        }
      }
    },
    "No camera image yet. Give the camera a moment and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Kamerabild. Gib der Kamera einen Moment und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει ακόμη εικόνα από την κάμερα. Περίμενε λίγο και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay imagen de la cámara. Dale un momento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d'image de la caméra. Patientez un instant et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna immagine dalla fotocamera. Attendi un istante e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだカメラ画像がありません。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 카메라 이미지가 없습니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há imagem da câmera. Aguarde um momento e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения с камеры пока нет. Подождите секунду и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення з камери ще немає. Зачекайте мить і спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "仲未有相機畫面。等一陣再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无相机画面。请稍候片刻再试。"
          }
        }
      }
    },
