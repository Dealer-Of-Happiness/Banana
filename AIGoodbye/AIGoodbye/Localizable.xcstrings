    "The AI model isn't ready yet. Download or select a model in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Modell ist noch nicht bereit. Laden oder wählen Sie ein Modell in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο AI δεν είναι έτοιμο ακόμα. Κάντε λήψη ή επιλέξτε ένα μοντέλο στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de IA aún no está listo. Descarga o selecciona un modelo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'IA n'est pas encore prêt. Téléchargez ou sélectionnez un modèle dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello IA non è ancora pronto. Scarica o seleziona un modello in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIモデルの準備がまだできていません。設定でモデルをダウンロードまたは選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 모델이 아직 준비되지 않았습니다. 설정에서 모델을 다운로드하거나 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de IA ainda não está pronto. Baixe ou selecione um modelo nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ИИ ещё не готова. Скачайте или выберите модель в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ШІ ще не готова. Завантажте або виберіть модель у Налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 模型尚未就緒。請在設定中下載或選擇模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 模型尚未就绪。请在设置中下载或选择模型。"
          }
        }
      }
    },
    "The app asks for the camera, microphone and speech recognition only when you use those features, and works fully without them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App fragt nur dann nach Kamera, Mikrofon und Spracherkennung, wenn Sie diese Funktionen nutzen – und funktioniert auch ganz ohne sie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εφαρμογή ζητά κάμερα, μικρόφωνο και αναγνώριση ομιλίας μόνο όταν χρησιμοποιείτε αυτές τις λειτουργίες, και δουλεύει κανονικά και χωρίς αυτές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app pide la cámara, el micrófono y el reconocimiento de voz solo cuando usas esas funciones, y funciona perfectamente sin ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app demande l'accès à la caméra, au micro et à la reconnaissance vocale uniquement quand vous utilisez ces fonctions, et fonctionne parfaitement sans elles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app chiede fotocamera, microfono e riconoscimento vocale solo quando usi queste funzioni, e funziona benissimo anche senza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラ、マイク、音声認識の許可を求めるのは、それらの機能を使うときだけです。なくてもアプリは問題なく使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱은 카메라, 마이크, 음성 인식을 해당 기능을 사용할 때만 요청하며, 없어도 아무 문제 없이 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app pede câmera, microfone e reconhecimento de fala só quando você usa esses recursos, e funciona muito bem sem eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение запрашивает камеру, микрофон и распознавание речи только тогда, когда вы пользуетесь этими функциями, и полностью работает без них."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Застосунок запитує камеру, мікрофон і розпізнавання мовлення лише тоді, коли ви користуєтеся цими функціями, і повністю працює без них."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只有喺你用相機、麥克風同語音辨識嘅時候，應用程式先會要求權限；冇咗佢哋，一樣用得晒。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有在您使用相机、麦克风和语音识别这些功能时，应用才会请求相应权限；没有它们，应用也能完整使用。"
          }
        }
      }
    },
    "The camera isn't available. Check camera permission in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht verfügbar. Prüfe die Kameraberechtigung in der Einstellungen-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα δεν είναι διαθέσιμη. Ελέγξτε την άδεια κάμερας στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible. Comprueba el permiso de cámara en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra n'est pas disponible. Vérifiez l'autorisation de la caméra dans l'app Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è disponibile. Controlla il permesso della fotocamera nell'app Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを利用できません。設定アプリでカメラの許可を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라를 사용할 수 없습니다. 설정 앱에서 카메라 권한을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não está disponível. Verifique a permissão da câmera no app Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Проверьте разрешение камеры в приложении «Настройки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна. Перевірте дозвіл камери в застосунку «Налаштування»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "用唔到相機。請喺「設定」App度檢查相機權限。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机不可用。请在「设置」应用中检查相机权限。"
          }
        }
      }
    },
    "The connection timed out. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Verbindung. Bitte versuchen Sie es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση έληξε λόγω χρονικού ορίου. Δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de conexión. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione scaduta. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がタイムアウトしました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 시간이 초과되었습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão expirou. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания подключения истекло. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час очікування з'єднання минув. Повторіть спробу."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連線逾時。請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时。请重试。"
          }
        }
      }
    },
    "The download couldn't start. Check your internet connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download konnte nicht gestartet werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η έναρξη της λήψης. Ελέγξτε τη σύνδεσή σας στο διαδίκτυο και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la descarga. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement n'a pas pu démarrer. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il download. Controlla la connessione a internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードを開始できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드를 시작할 수 없습니다. 인터넷 연결을 확인한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o download. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать загрузку. Проверьте подключение к интернету и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося почати завантаження. Перевірте підключення до інтернету та спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開始唔到下載。請檢查網絡連線再試多次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始下载。请检查网络连接后重试。"
          }
        }
      }
    },
    "The microphone couldn't be started. Check that another app isn't using it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte nicht gestartet werden. Prüfe, ob eine andere App es verwendet."
          }
        },
        "el": {
          "stringUnit": {
