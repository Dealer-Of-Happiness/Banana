          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 已关闭。请在设置中开启以使用内置模型。"
          }
        }
      }
    },
    "Apple Intelligence isn't ready. Choose a downloaded model in Settings.": {
      "localizations": {
