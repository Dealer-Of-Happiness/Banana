    "Find any message or conversation. Nothing is sent anywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie jede Nachricht und jede Unterhaltung. Es wird nichts irgendwohin gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Βρείτε οποιοδήποτε μήνυμα ή συνομιλία. Τίποτα δεν στέλνεται πουθενά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra cualquier mensaje o conversación. No se envía nada a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrouvez n'importe quel message ou conversation. Rien n'est envoyé nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova qualsiasi messaggio o conversazione. Non viene inviato nulla da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのメッセージも会話も探せます。どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 메시지나 대화든 찾아보세요. 아무것도 어디로도 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre qualquer mensagem ou conversa. Nada é enviado para lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите любое сообщение или беседу. Ничего никуда не отправляется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знайдіть будь-яке повідомлення чи розмову. Нічого нікуди не надсилається."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "搵到任何訊息或者對話。冇任何嘢會傳送出去。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找任意消息或对话。不会向任何地方发送内容。"
          }
        }
      }
    },
