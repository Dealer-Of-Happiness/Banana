    "Listens, translates and speaks continuously, switching languages automatically": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört zu, übersetzt und spricht durchgehend und wechselt die Sprache automatisch"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ακούει, μεταφράζει και μιλά συνεχώς, εναλλάσσοντας γλώσσες αυτόματα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha, traduce y habla continuamente, cambiando de idioma automáticamente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute, traduit et parle en continu, en changeant de langue automatiquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta, traduce e parla di continuo, cambiando lingua automaticamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "継続的に聞き取り、翻訳して読み上げ、言語を自動で切り替えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 듣고 번역해 말해 주며, 언어를 자동으로 전환합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouve, traduz e fala continuamente, alternando os idiomas automaticamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрерывно слушает, переводит и говорит, автоматически переключая языки"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безперервно слухає, перекладає та говорить, автоматично перемикаючи мови"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "持續聆聽、翻譯同讀出嚟，自動切換語言"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持续聆听、翻译并朗读，自动切换语言"
          }
        }
      }
    },
