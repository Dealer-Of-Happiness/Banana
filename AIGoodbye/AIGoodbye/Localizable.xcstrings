    "Transcription isn't available right now, so this recording will be audio only.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription ist gerade nicht verfügbar, deshalb wird diese Aufnahme nur Audio enthalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απομαγνητοφώνηση δεν είναι διαθέσιμη αυτή τη στιγμή, οπότε αυτή η εγγραφή θα είναι μόνο ήχος."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no hay transcripción disponible, así que esta grabación será solo de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription n'est pas disponible pour le moment : cet enregistrement sera audio uniquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione non è disponibile al momento, quindi questa registrazione sarà solo audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、文字起こしが利用できないため、この録音は音声のみになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 텍스트 변환을 사용할 수 없어 이 녹음은 오디오만 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição não está disponível agora, então esta gravação será só de áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка сейчас недоступна, поэтому эта запись будет только со звуком."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розшифровка зараз недоступна, тож цей запис буде лише зі звуком."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "而家用唔到文字轉錄，所以呢段只會錄聲音。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法进行文字转录，因此这次只会录制音频。"
          }
        }
      }
    },
    "Transcription stopped, but recording is continuing. The audio is being saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transkription wurde beendet, die Aufnahme läuft weiter. Das Audio wird gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η απομαγνητοφώνηση σταμάτησε, αλλά η εγγραφή συνεχίζεται. Ο ήχος αποθηκεύεται."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcripción se ha detenido, pero la grabación continúa. El audio se está guardando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription s'est arrêtée, mais l'enregistrement continue. L'audio est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trascrizione si è interrotta, ma la registrazione continua. L'audio viene salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字起こしは停止しましたが、録音は続いています。音声は保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트 변환은 멈췄지만 녹음은 계속되고 있습니다. 오디오는 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transcrição parou, mas a gravação continua. O áudio está sendo salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расшифровка остановилась, но запись продолжается. Звук сохраняется."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розшифровка зупинилася, але запис триває. Звук зберігається."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "文字轉錄停咗，但錄音繼續，聲音會保存低。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字转录已停止，但录音仍在继续，音频会保存。"
          }
        }
      }
    },
