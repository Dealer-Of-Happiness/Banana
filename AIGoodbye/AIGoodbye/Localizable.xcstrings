    "Your device is out of free space. Free up storage and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gerät hat keinen freien Speicher mehr. Gib Speicher frei und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή σας δεν έχει ελεύθερο χώρο. Ελευθερώστε αποθηκευτικό χώρο και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo se quedó sin espacio libre. Libera almacenamiento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil n'a plus d'espace libre. Libérez du stockage et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo ha esaurito lo spazio libero. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの空き容量がありません。ストレージを空けてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 여유 공간이 없습니다. 저장 공간을 확보한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dispositivo está sem espaço livre. Libere armazenamento e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве закончилось свободное место. Освободите память и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На пристрої закінчилося вільне місце. Звільніть сховище та спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置嘅可用空間用晒。請清出儲存空間再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可用空间已用完。请释放存储空间后重试。"
          }
        }
      }
    },
