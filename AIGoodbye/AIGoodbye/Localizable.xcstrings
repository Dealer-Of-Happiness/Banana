    "Your device is out of free space. Free up storage and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Gerät hat keinen freien Speicher mehr. Gib Speicher frei und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή σου δεν έχει ελεύθερο χώρο. Ελευθέρωσε αποθηκευτικό χώρο και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dispositivo se quedó sin espacio libre. Libera almacenamiento e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre appareil n'a plus d'espace libre. Libérez du stockage et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo ha esaurito lo spazio libero. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの空き容量がありません。ストレージを空けてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 여유 공간이 없습니다. 저장 공간을 확보한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dispositivo está sem espaço livre. Libere armazenamento e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве закончилось свободное место. Освободите память и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На пристрої закінчилося вільне місце. Звільніть сховище та спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置嘅可用空間用晒。請清出儲存空間再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备可用空间已用完。请释放存储空间后重试。"
          }
        }
      }
    },
    "Your downloaded model answers inside AiGoodbye. Continue there?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein geladenes Modell antwortet in AiGoodbye. Dort weitermachen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο που έχεις κατεβάσει απαντά μέσα στο AiGoodbye. Συνέχεια εκεί;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu modelo descargado responde dentro de AiGoodbye. ¿Continuar allí?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre modèle téléchargé répond dans AiGoodbye. Continuer dans l'app ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello scaricato risponde dentro AiGoodbye. Vuoi continuare lì?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたモデルはAiGoodbyeの中で回答します。アプリで続けますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 모델은 AiGoodbye 안에서 답변합니다. 앱에서 계속할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu modelo baixado responde dentro do AiGoodbye. Continuar lá?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачанная модель отвечает внутри AiGoodbye. Продолжить там?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажена модель відповідає в AiGoodbye. Продовжити там?"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你下載嘅模型喺 AiGoodbye 入面回答。要喺嗰度繼續嗎？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你下载的模型在 AiGoodbye 内回答。要在那里继续吗？"
          }
        }
      }
    },
    "Your downloaded model answers only while AiGoodbye is open. Open the app, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein geladenes Modell antwortet nur, wenn AiGoodbye geöffnet ist. Öffne die App und versuche es dann erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο που έχεις κατεβάσει απαντά μόνο όσο το AiGoodbye είναι ανοιχτό. Άνοιξε την εφαρμογή και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu modelo descargado solo responde mientras AiGoodbye está abierto. Abre la app e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre modèle téléchargé ne répond que lorsque AiGoodbye est ouvert. Ouvrez l'app, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello scaricato risponde solo quando AiGoodbye è aperto. Apri l'app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたモデルは、AiGoodbyeを開いているときだけ回答します。アプリを開いてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 모델은 AiGoodbye가 열려 있을 때만 답변합니다. 앱을 연 다음 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu modelo baixado só responde enquanto o AiGoodbye está aberto. Abra o app e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скачанная модель отвечает, только когда AiGoodbye открыто. Откройте приложение и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажена модель відповідає, лише коли AiGoodbye відкрито. Відкрийте застосунок і спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你下載嘅模型只會喺 AiGoodbye 開住嘅時候回答。開咗 App 之後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你下载的模型只在 AiGoodbye 打开时回答。请打开 App 后重试。"
          }
        }
      }
    },
