    "That doesn't look like a model address. Use the form owner/model-name, for example mlx-community/Qwen3-VL-2B-Instruct-4bit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht nach einer Modelladresse aus. Verwende die Form owner/model-name, zum Beispiel mlx-community/Qwen3-VL-2B-Instruct-4bit."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό δεν μοιάζει με διεύθυνση μοντέλου. Χρησιμοποίησε τη μορφή owner/model-name, για παράδειγμα mlx-community/Qwen3-VL-2B-Instruct-4bit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso no parece una dirección de modelo. Usa el formato owner/model-name, por ejemplo mlx-community/Qwen3-VL-2B-Instruct-4bit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à une adresse de modèle. Utilisez la forme owner/model-name, par exemple mlx-community/Qwen3-VL-2B-Instruct-4bit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sembra un indirizzo di modello. Usa la forma owner/model-name, ad esempio mlx-community/Qwen3-VL-2B-Instruct-4bit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのアドレスではないようです。owner/model-name の形式で入力してください（例: mlx-community/Qwen3-VL-2B-Instruct-4bit）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 주소 형식이 아닌 것 같습니다. owner/model-name 형식으로 입력하세요. 예: mlx-community/Qwen3-VL-2B-Instruct-4bit"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso não parece um endereço de modelo. Use o formato owner/model-name, por exemplo mlx-community/Qwen3-VL-2B-Instruct-4bit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не похоже на адрес модели. Используйте форму owner/model-name, например mlx-community/Qwen3-VL-2B-Instruct-4bit."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не схоже на адресу моделі. Використовуйте форму owner/model-name, наприклад mlx-community/Qwen3-VL-2B-Instruct-4bit."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這看起來不是模型位址。請使用 owner/model-name 的形式，例如 mlx-community/Qwen3-VL-2B-Instruct-4bit。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这看起来不是模型地址。请使用 owner/model-name 的形式，例如 mlx-community/Qwen3-VL-2B-Instruct-4bit。"
          }
        }
      }
    },
    "That model has already been added.": {
