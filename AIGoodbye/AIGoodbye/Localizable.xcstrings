    "Private, on-device AI. No internet needed, no subscriptions, no data leaving your device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private KI direkt auf dem Gerät. Kein Internet nötig, keine Abos, keine Daten verlassen dein Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ιδιωτικό AI στη συσκευή. Χωρίς ίντερνετ, χωρίς συνδρομές, κανένα δεδομένο δεν φεύγει από τη συσκευή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IA privada en tu dispositivo. Sin internet, sin suscripciones, sin datos que salgan de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IA privée, sur l'appareil. Pas d'internet requis, pas d'abonnement, aucune donnée ne quitte votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IA privata sul dispositivo. Niente internet, niente abbonamenti, nessun dato lascia il tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートなオンデバイスAI。インターネット不要、サブスクなし、データはデバイスから出ません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프라이빗 온디바이스 AI. 인터넷 불필요, 구독 없음, 데이터는 기기를 떠나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IA privada, no dispositivo. Sem internet, sem assinaturas, nenhum dado sai do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватный ИИ на устройстве. Не нужен интернет, нет подписок, данные не покидают ваше устройство."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватний ШІ на пристрої. Без інтернету, без підписок, дані не залишають ваш пристрій."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "私密嘅裝置端 AI。唔使上網，冇訂閱，數據唔會離開你部裝置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私密的设备端 AI。无需网络，无订阅，数据不离开您的设备。"
          }
        }
      }
    },
    "Questions or ideas? Visit aigoodbye.ai or email marketing@dealerofhappiness.com. We would love to hear from you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen oder Ideen? Besuchen Sie aigoodbye.ai oder schreiben Sie an marketing@dealerofhappiness.com. Wir freuen uns, von Ihnen zu hören."
          }
