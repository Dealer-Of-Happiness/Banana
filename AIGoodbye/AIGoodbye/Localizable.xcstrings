    "Apple Intelligence is turned off. Enable it in Settings to use the built-in model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert. Aktivieren Sie es in den Einstellungen, um das integrierte Modell zu verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence είναι απενεργοποιημένο. Ενεργοποιήστε το στις Ρυθμίσεις για να χρησιμοποιήσετε το ενσωματωμένο μοντέλο."
          }
        },
        "es": {
