    "Apple Intelligence declined this request. Try rephrasing, or switch to a downloaded model in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence hat diese Anfrage abgelehnt. Formulieren Sie sie um oder wechseln Sie in den Einstellungen zu einem geladenen Modell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence απέρριψε αυτό το αίτημα. Δοκιμάστε να το αναδιατυπώσετε ή μεταβείτε σε ένα μοντέλο που έχει ληφθεί στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence rechazó esta solicitud. Prueba a reformularla o cambia a un modelo descargado en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence a refusé cette demande. Reformulez-la ou passez à un modèle téléchargé dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ha rifiutato questa richiesta. Prova a riformularla o passa a un modello scaricato in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceがこのリクエストを拒否しました。言い換えるか、設定でダウンロード済みのモデルに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 이 요청을 거부했습니다. 표현을 바꿔 보거나 설정에서 다운로드된 모델로 전환하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence recusou esta solicitação. Tente reformular ou mude para um modelo baixado nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence отклонил этот запрос. Переформулируйте его или переключитесь на скачанную модель в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence відхилив цей запит. Спробуйте переформулювати його або перейдіть на завантажену модель у Налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 拒絕了此請求。請嘗試換個說法，或在設定中改用已下載的模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 拒绝了此请求。请尝试换种说法，或在设置中切换到已下载的模型。"
          }
        }
      }
    },
