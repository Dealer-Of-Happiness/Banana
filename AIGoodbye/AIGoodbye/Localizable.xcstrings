          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist nicht bereit. Wählen Sie in den Einstellungen ein geladenes Modell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence δεν είναι έτοιμο. Επιλέξτε στις Ρυθμίσεις ένα μοντέλο που έχει ληφθεί."
          }
        },
        "es": {
