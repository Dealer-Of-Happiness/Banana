    "Download cancelled, so your message wasn't answered. What was already downloaded is kept - tap Try Again to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download abgebrochen, deine Nachricht wurde daher nicht beantwortet. Das bereits Geladene bleibt erhalten – tippe auf „Erneut versuchen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη ακυρώθηκε, οπότε το μήνυμά σου δεν απαντήθηκε. Ό,τι έχει ήδη κατέβει διατηρείται – πάτησε «Δοκίμασε ξανά»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga cancelada, así que tu mensaje no se respondió. Lo ya descargado se conserva: toca «Reintentar» para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement annulé, votre message n'a donc pas eu de réponse. Ce qui a déjà été téléchargé est conservé : touchez « Réessayer »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download annullato, quindi il tuo messaggio non ha ricevuto risposta. Ciò che è già stato scaricato viene conservato: tocca «Riprova»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードをキャンセルしたため、メッセージには回答できませんでした。すでにダウンロードした分は保持されます。「再試行」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드를 취소해 메시지에 답하지 못했습니다. 이미 받은 부분은 유지되니 ‘다시 시도’를 누르세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Download cancelado, então sua mensagem não foi respondida. O que já foi baixado é mantido — toque em «Tentar de novo»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка отменена, поэтому на сообщение не ответили. Уже загруженное сохранено — нажмите «Повторить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантаження скасовано, тому на повідомлення не відповіли. Уже завантажене збережено — натисніть «Повторити»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "下載已取消，因此未回答你的訊息。已下載的部分會保留——點一下「重試」以繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已取消，因此未回答你的消息。已下载的部分会保留——点按“重试”以继续。"
          }
        }
      }
    },
