          "stringUnit": {
            "state": "translated",
            "value": "音频设备已更换，录音继续进行。"
          }
        }
      }
    },
    "The audio file couldn't be created, so only the transcript will be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiodatei konnte nicht erstellt werden, daher wird nur das Transkript gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δημιουργία του αρχείου ήχου, οπότε θα αποθηκευτεί μόνο η απομαγνητοφώνηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo crear el archivo de audio, así que solo se guardará la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier audio n'a pas pu être créé : seule la transcription sera enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare il file audio, quindi verrà salvata solo la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声ファイルを作成できなかったため、文字起こしのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 파일을 만들지 못해 텍스트 기록만 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o arquivo de áudio, então apenas a transcrição será salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать аудиофайл, поэтому сохранится только расшифровка."
