    "Hands-free stopped after two minutes of silence. Tap to start again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freihändiger Modus nach zwei Minuten Stille beendet. Tippe, um ihn neu zu starten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λειτουργία χωρίς χέρια σταμάτησε μετά από δύο λεπτά σιωπής. Πάτησε για να την ξεκινήσεις ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo manos libres se detuvo tras dos minutos de silencio. Toca para volver a empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode mains libres s'est arrêté après deux minutes de silence. Touchez pour le relancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità a mani libere si è interrotta dopo due minuti di silenzio. Tocca per ricominciare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2分間無音だったため、ハンズフリーを停止しました。タップすると再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2분 동안 소리가 없어 핸즈프리가 중지되었습니다. 탭하여 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo mãos livres parou após dois minutos de silêncio. Toque para começar de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрерывный разговор остановлен после двух минут тишины. Нажмите, чтобы начать снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безперервну розмову зупинено після двох хвилин тиші. Торкніться, щоб почати знову."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "兩分鐘冇聲，免提已經停咗。撳一下重新開始。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两分钟没有声音，免提已停止。轻点即可重新开始。"
          }
        }
      }
    },
    "Hands-free stopped because another app took over the audio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freisprechmodus beendet, weil eine andere App den Ton übernommen hat."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λειτουργία handsfree σταμάτησε επειδή μια άλλη εφαρμογή ανέλαβε τον ήχο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands-free stopped because another app took over the audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo manos libres se detuvo porque otra app tomó el control del audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode mains libres s'est arrêté, car une autre app a pris le contrôle de l'audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità a mani libere si è interrotta perché un'altra app ha preso il controllo dell'audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のアプリがオーディオを使用したため、ハンズフリーを停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 오디오를 사용해 핸즈프리가 중지되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo mãos livres parou porque outro app assumiu o áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Непрерывный разговор остановлен: другое приложение заняло звук."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Безперервну розмову зупинено: інший застосунок зайняв звук."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "免提已停止，因為另一個 App 接管咗音訊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免提已停止，因为另一个应用接管了音频。"
          }
        }
      }
    },
