    "Analyzing images needs the %1$@ vision model (%2$@). It downloads once and then works offline.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Bildanalyse wird das Vision-Modell %1$@ (%2$@) benötigt. Es wird einmal geladen und funktioniert danach offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para analizar imágenes se necesita el modelo de visión %1$@ (%2$@). Se descarga una sola vez y luego funciona sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'analyse d'images nécessite le modèle de vision %1$@ (%2$@). Il se télécharge une seule fois, puis fonctionne hors ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per analizzare le immagini serve il modello di visione %1$@ (%2$@). Si scarica una sola volta e poi funziona offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の分析には%1$@ビジョンモデル（%2$@）が必要です。一度ダウンロードすれば、その後はオフラインで動作します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise de imagens precisa do modelo de visão %1$@ (%2$@). Ele é baixado uma vez e depois funciona offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для анализа изображений нужна модель компьютерного зрения %1$@ (%2$@). Она скачивается один раз и затем работает офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析图像需要 %1$@ 视觉模型（%2$@）。只需下载一次，之后即可离线使用。"
          }
        }
      }
    },
