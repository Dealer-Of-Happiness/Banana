    "This recording reached the four hour limit and was saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aufnahme hat das Limit von vier Stunden erreicht und wurde gesichert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η ηχογράφηση έφτασε το όριο των τεσσάρων ωρών και αποθηκεύτηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta grabación alcanzó el límite de cuatro horas y se guardó."
          }
        },
        "fr": {
          "stringUnit": {
