            "state": "translated",
            "value": "Das Löschen eines Modells gibt sofort Speicherplatz frei. Es wird beim nächsten Gebrauch erneut geladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar un modelo libera espacio de inmediato. Se volverá a descargar la próxima vez que lo uses."
          }
        },
        "fr": {
          "stringUnit": {
