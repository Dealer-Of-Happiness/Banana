          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle est déjà intégré : choisissez-le dans la liste des modèles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel modello è già integrato: sceglilo dall'elenco dei modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのモデルはすでに内蔵されています。モデル一覧から選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 이미 기본으로 포함되어 있습니다. 모델 목록에서 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse modelo já vem integrado: escolha-o na lista de modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель уже встроена — выберите её в списке моделей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця модель уже вбудована — виберіть її в списку моделей."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個模型已經內置，請喺模型清單揀選。"
