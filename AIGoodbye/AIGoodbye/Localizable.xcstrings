    },
    "The model isn't downloaded yet, so your message wasn't answered.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell ist noch nicht geladen, daher wurde deine Nachricht nicht beantwortet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο δεν έχει κατέβει ακόμη, οπότε το μήνυμά σας δεν απαντήθηκε."
