    "Not enough free space. %@ needs about %@ free. Free up space and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug freier Speicher. %1$@ benötigt etwa %2$@ frei. Gib Speicher frei und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετός ελεύθερος χώρος. Το %1$@ χρειάζεται περίπου %2$@ ελεύθερα. Ελευθερώστε χώρο και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio libre. %1$@ necesita unos %2$@ libres. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace libre insuffisant. %1$@ nécessite environ %2$@ d'espace libre. Libérez de l'espace et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio libero insufficiente. %1$@ richiede circa %2$@ liberi. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が足りません。%1$@には約%2$@の空きが必要です。容量を空けてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 공간이 부족합니다. %1$@에는 약 %2$@의 여유 공간이 필요합니다. 공간을 확보한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espaço livre insuficiente. %1$@ precisa de cerca de %2$@ livres. Libere espaço e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно свободного места. Для %1$@ нужно около %2$@. Освободите место и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо вільного місця. Для %1$@ потрібно близько %2$@. Звільніть місце та спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間唔夠。%1$@ 需要大約 %2$@ 空間。請清出空間再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间不足。%1$@ 需要约 %2$@ 的可用空间。请释放空间后重试。"
          }
        }
      }
    },
    "Nothing remembered yet.": {
