    "This conversation is too long for Apple Intelligence. Start a new chat or switch to a downloaded model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung ist zu lang für Apple Intelligence. Beginnen Sie einen neuen Chat oder wechseln Sie zu einem geladenen Modell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή η συζήτηση είναι πολύ μεγάλη για το Apple Intelligence. Ξεκινήστε μια νέα συνομιλία ή μεταβείτε σε ένα μοντέλο που έχει ληφθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación es demasiado larga para Apple Intelligence. Inicia un nuevo chat o cambia a un modelo descargado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation est trop longue pour Apple Intelligence. Commencez une nouvelle conversation ou passez à un modèle téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa conversazione è troppo lunga per Apple Intelligence. Inizia una nuova chat o passa a un modello scaricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話はApple Intelligenceには長すぎます。新しいチャットを始めるか、ダウンロード済みのモデルに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화는 Apple Intelligence가 처리하기에 너무 깁니다. 새로운 채팅을 시작하거나 다운로드된 모델로 전환하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa é longa demais para a Apple Intelligence. Comece uma nova conversa ou mude para um modelo baixado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта беседа слишком длинная для Apple Intelligence. Начните новый чат или переключитесь на скачанную модель."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця розмова занадто довга для Apple Intelligence. Почніть новий чат або перейдіть на завантажену модель."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話對 Apple Intelligence 來說太長。請開始新聊天，或改用已下載的模型。"
