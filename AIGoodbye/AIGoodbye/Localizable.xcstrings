    "No readable text was found in this scan. Try again with more light, or hold the camera steady.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Scan wurde kein lesbarer Text gefunden. Versuche es mit mehr Licht oder halte die Kamera ruhig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε αναγνώσιμο κείμενο σε αυτή τη σάρωση. Δοκίμασε ξανά με περισσότερο φως ή κράτησε σταθερή την κάμερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró texto legible en este escaneo. Inténtalo con más luz o mantén la cámara firme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun texte lisible n'a été trouvé dans cette numérisation. Réessayez avec plus de lumière ou en tenant l'appareil stable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa scansione non è stato trovato testo leggibile. Riprova con più luce o tenendo ferma la fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスキャンから読み取れる文字が見つかりませんでした。明るい場所で、カメラを固定してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 스캔에서 읽을 수 있는 텍스트를 찾지 못했습니다. 더 밝은 곳에서 카메라를 안정적으로 잡고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum texto legível foi encontrado nesta digitalização. Tente de novo com mais luz ou segurando a câmera firme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом скане не найден распознаваемый текст. Попробуйте при большем освещении или держите камеру ровнее."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
