      }
    },
    "Only the first %lld pages were read. Scan the rest separately.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die ersten %lld Seiten wurden gelesen. Den Rest bitte separat scannen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Διαβάστηκαν μόνο οι πρώτες %lld σελίδες. Σαρώστε τις υπόλοιπες ξεχωριστά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se han leído las primeras %lld páginas. Escanea el resto por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les %lld premières pages ont été lues. Numérisez le reste séparément."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono state lette solo le prime %lld pagine. Scansiona il resto separatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の%lldページのみ読み取りました。残りは別に読み取ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 %lld페이지만 읽었습니다. 나머지는 따로 스캔해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as primeiras %lld páginas foram lidas. Digitalize o resto separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитаны только первые %lld страниц. Остальные отсканируйте отдельно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитано лише перші %lld сторінок. Решту відскануйте окремо."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "只讀咗頭 %lld 頁，其餘請分開掃描。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只读取了前 %lld 页，其余请分开扫描。"
          }
        }
      }
    },
    "Open AiGoodbye once to set up an AI model, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne AiGoodbye einmal, um ein KI-Modell einzurichten, und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το AiGoodbye μία φορά για να ρυθμίσετε ένα μοντέλο AI και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AiGoodbye una vez para configurar un modelo de IA y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez AiGoodbye une fois pour configurer un modèle d'IA, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri AiGoodbye una volta per configurare un modello di IA, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeを一度開いてAIモデルを設定してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye를 한 번 열어 AI 모델을 설정한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o AiGoodbye uma vez para configurar um modelo de IA e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте AiGoodbye один раз, чтобы настроить модель ИИ, и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте AiGoodbye один раз, щоб налаштувати модель ШІ, і спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請先開一次 AiGoodbye 設定好 AI 模型，然後再試。"
          }
        },
