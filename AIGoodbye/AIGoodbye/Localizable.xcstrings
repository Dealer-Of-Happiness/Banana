    "Describing surroundings needs the %@ vision model. Download it from the chat screen first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Umgebungsbeschreibung wird das Bildmodell %@ benötigt. Lade es zuerst im Chat herunter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η περιγραφή περιβάλλοντος χρειάζεται το μοντέλο όρασης %@. Κατέβασέ το πρώτα από την οθόνη συνομιλίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describir el entorno requiere el modelo de visión %@. Descárgalo primero desde la pantalla de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La description de l'environnement nécessite le modèle visuel %@. Téléchargez-le d'abord depuis l'écran de discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La descrizione dell'ambiente richiede il modello visivo %@. Scaricalo prima dalla schermata della chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "周囲の説明には画像モデル %@ が必要です。先にチャット画面からダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 설명에는 비전 모델 %@가 필요합니다. 먼저 채팅 화면에서 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrever o ambiente exige o modelo de visão %@. Baixe-o primeiro na tela de conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для описания окружения нужна модель зрения %@. Сначала загрузите её на экране чата."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для опису оточення потрібна модель зору %@. Спершу завантажте її на екрані чату."
