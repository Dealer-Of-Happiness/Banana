    "No model with that name was found on Hugging Face. Check the spelling, and note that private and gated models can't be used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Hugging Face wurde kein Modell mit diesem Namen gefunden. Prüfe die Schreibweise; private und zugangsbeschränkte Modelle lassen sich nicht verwenden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε μοντέλο με αυτό το όνομα στο Hugging Face. Έλεγξε την ορθογραφία· τα ιδιωτικά και τα περιορισμένα μοντέλα δεν μπορούν να χρησιμοποιηθούν."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún modelo con ese nombre en Hugging Face. Revisa la ortografía; los modelos privados o restringidos no se pueden usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun modèle portant ce nom n'a été trouvé sur Hugging Face. Vérifiez l'orthographe ; les modèles privés ou à accès restreint ne peuvent pas être utilisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello con quel nome è stato trovato su Hugging Face. Controlla l'ortografia; i modelli privati o ad accesso limitato non possono essere usati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名前のモデルは Hugging Face で見つかりませんでした。スペルを確認してください。非公開モデルや利用申請が必要なモデルは使えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face에서 해당 이름의 모델을 찾지 못했습니다. 철자를 확인하세요. 비공개 모델이나 접근 승인이 필요한 모델은 사용할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo com esse nome foi encontrado no Hugging Face. Confira a grafia; modelos privados ou com acesso restrito não podem ser usados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель с таким именем не найдена на Hugging Face. Проверьте написание; приватные модели и модели с ограниченным доступом использовать нельзя."
          }
        },
        "uk": {
          "stringUnit": {
