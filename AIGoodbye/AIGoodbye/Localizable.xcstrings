    "No mail app is set up on this device. Write to %@ from any email account.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine Mail-App eingerichtet. Schreib an %@ von einem beliebigen E-Mail-Konto."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν έχει ρυθμιστεί εφαρμογή email σε αυτή τη συσκευή. Γράψτε στο %@ από οποιονδήποτε λογαριασμό email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna app de correo configurada en este dispositivo. Escribe a %@ desde cualquier cuenta de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune app de messagerie n'est configurée sur cet appareil. Écrivez à %@ depuis n'importe quel compte e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo dispositivo non è configurata nessuna app di posta. Scrivi a %@ da qualsiasi account email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはメールアプリが設定されていません。お好きなメールアカウントから%@までお送りください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 설정된 메일 앱이 없습니다. 아무 이메일 계정에서나 %@(으)로 보내 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum app de e-mail está configurado neste dispositivo. Escreva para %@ de qualquer conta de e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве не настроена почта. Напишите на %@ с любого почтового ящика."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої не налаштовано пошту. Напишіть на %@ з будь-якої поштової скриньки."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這部裝置未設定任何郵件 App。請用任何電郵帳戶寫信到 %@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备未设置任何邮件 App。请用任意邮箱写信至 %@。"
          }
        }
      }
    }
