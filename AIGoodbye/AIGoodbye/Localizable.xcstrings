{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%@ - %@": {
      "shouldTranslate": false
    },
    "%@ can't run on this engine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann auf dieser Engine nicht ausgeführt werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %@ δεν μπορεί να εκτελεστεί σε αυτόν τον μηχανισμό."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede ejecutarse en este motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas s'exécuter sur ce moteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può essere eseguito su questo motore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのエンジンでは実行できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이 엔진에서 실행할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode ser executado neste mecanismo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не может работать на этом движке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не може працювати на цьому рушії."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 無法在此引擎上執行。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法在此引擎上运行。"
          }
        }
      }
    },
    "%@ needs about %lld GB of memory and this device can only give the app about %@ GB right now. Close other apps and try again, or choose a smaller model.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ benötigt etwa %2$lld GB Speicher, dieses Gerät kann der App derzeit aber nur etwa %3$@ GB geben. Schließe andere Apps und versuche es erneut, oder wähle ein kleineres Modell."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το %1$@ χρειάζεται περίπου %2$lld GB μνήμης, αλλά αυτή η συσκευή μπορεί να δώσει στην εφαρμογή μόνο περίπου %3$@ GB αυτή τη στιγμή. Κλείσε άλλες εφαρμογές και δοκίμασε ξανά, ή διάλεξε ένα μικρότερο μοντέλο."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ needs about %2$lld GB of memory and this device can only give the app about %3$@ GB right now. Close other apps and try again, or choose a smaller model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ necesita unos %2$lld GB de memoria y este dispositivo solo puede darle a la app unos %3$@ GB ahora mismo. Cierra otras apps e inténtalo de nuevo, o elige un modelo más pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a besoin d'environ %2$lld Go de mémoire, mais cet appareil ne peut en donner à l'app qu'environ %3$@ Go pour le moment. Fermez d'autres apps et réessayez, ou choisissez un modèle plus petit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ richiede circa %2$lld GB di memoria e al momento questo dispositivo può darne all'app solo circa %3$@ GB. Chiudi altre app e riprova, oppure scegli un modello più piccolo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@には約%2$lld GBのメモリが必要ですが、このデバイスが現在アプリに割り当てられるのは約%3$@ GBです。他のアプリを閉じてやり直すか、より小さいモデルを選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에는 약 %2$lld GB의 메모리가 필요하지만, 이 기기가 지금 앱에 줄 수 있는 메모리는 약 %3$@ GB입니다. 다른 앱을 닫고 다시 시도하거나 더 작은 모델을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ precisa de cerca de %2$lld GB de memória, e este dispositivo só pode dar ao app cerca de %3$@ GB agora. Feche outros apps e tente de novo, ou escolha um modelo menor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ требует около %2$lld ГБ памяти, а это устройство сейчас может выделить приложению лишь около %3$@ ГБ. Закройте другие приложения и попробуйте снова или выберите модель поменьше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ потребує близько %2$lld ГБ пам'яті, а цей пристрій зараз може виділити застосунку лише близько %3$@ ГБ. Закрийте інші застосунки й спробуйте ще раз або виберіть меншу модель."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 需要大約 %2$lld GB 記憶體，但呢部裝置而家只可以畀 App 大約 %3$@ GB。閂咗其他 App 再試，或者揀個細啲嘅模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 需要约 %2$lld GB 内存，而此设备目前只能为 App 提供约 %3$@ GB。请关闭其他 App 后重试，或选择更小的模型。"
          }
        }
      }
    },
    "%@ needs to be downloaded first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss zuerst geladen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πρέπει πρώτα να γίνει λήψη του %@."
          }
        },
        "es": {
          "stringUnit": {
