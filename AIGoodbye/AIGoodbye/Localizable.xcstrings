    "Translate text privately, on-device, with no internet connection. Great after 'Get Clipboard' in a shortcut.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetze Text privat auf dem Gerät, ganz ohne Internetverbindung. Ideal nach „Zwischenablage abrufen“ in einem Kurzbefehl."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μετάφρασε κείμενο ιδιωτικά, στη συσκευή, χωρίς σύνδεση στο διαδίκτυο. Ιδανικό μετά το «Λήψη προχείρου» σε μια συντόμευση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduce texto de forma privada, en el dispositivo y sin conexión a internet. Ideal después de «Obtener portapapeles» en un atajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduisez du texte en privé, sur l'appareil, sans connexion Internet. Idéal après « Obtenir le presse-papiers » dans un raccourci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduci testo in privato, sul dispositivo, senza connessione a Internet. Ottimo dopo «Ottieni appunti» in un comando rapido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストを端末内でプライベートに翻訳します。インターネット接続は不要です。ショートカットの「クリップボードを取得」の後に最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 연결 없이 기기에서 텍스트를 비공개로 번역합니다. 단축어의 ‘클립보드 가져오기’ 다음에 쓰기 좋습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traduza texto de forma privada, no dispositivo, sem conexão com a internet. Ótimo depois de “Obter Área de Transferência” em um atalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводите текст приватно, на устройстве, без подключения к интернету. Отлично работает после действия «Получить буфер обмена» в быстрой команде."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перекладайте текст приватно, на пристрої, без підключення до інтернету. Чудово працює після дії «Отримати буфер обміну» у швидкій команді."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "喺裝置上私密噉翻譯文字，唔使連網。好啱放喺捷徑嘅「取得剪貼板」之後。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备上私密地翻译文本，无需联网。非常适合放在快捷指令的“获取剪贴板”之后。"
          }
        }
      }
    },
