            "value": "何も録音されませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 녹음되지 않았습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi gravado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не записано"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не записано"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "未錄製任何內容"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未录制任何内容"
          }
        }
      }
    },
    "Nothing you say leaves this device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts, was du sagst, verlässt dieses Gerät"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα από όσα λες δεν φεύγει από αυτή τη συσκευή"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo que dices sale de este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de ce que vous dites ne quitte cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di ciò che dici lascia questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容がこのデバイスから出ることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 내용은 이 기기를 벗어나지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada do que você diz sai deste dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего из сказанного не покидает это устройство"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніщо зі сказаного не залишає цей пристрій"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "你講嘅嘢一律唔會離開呢部裝置"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说的一切都不会离开这台设备"
          }
        }
      }
    },
    "OK": {
