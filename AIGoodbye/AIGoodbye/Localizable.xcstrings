    "Models are 1-6 GB, so downloading over Wi-Fi is recommended.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle sind 1–6 GB groß, daher wird das Laden über Wi-Fi empfohlen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μοντέλα είναι 1–6 GB, γι' αυτό συνιστάται λήψη μέσω Wi-Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos ocupan de 1 a 6 GB, así que se recomienda descargarlos por Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles font de 1 à 6 Go, il est donc recommandé de les télécharger en Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli occupano da 1 a 6 GB, quindi è consigliato scaricarli tramite Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは1〜6 GBあるため、Wi-Fiでのダウンロードをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 크기는 1~6GB이므로 Wi-Fi에서 다운로드하는 것을 권장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos têm de 1 a 6 GB, por isso é recomendável baixar por Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели занимают 1–6 ГБ, поэтому загружать их лучше по Wi-Fi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделі важать 1–6 ГБ, тому завантажувати їх краще через Wi-Fi."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "模型有 1–6 GB 咁大，所以建議用 Wi-Fi 下載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型大小为 1–6 GB，建议通过 Wi-Fi 下载。"
          }
        }
      }
    },
    "Models download once and then work fully offline. You can delete them anytime in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle werden einmal geladen und funktionieren danach vollständig offline. Sie können sie jederzeit in den Einstellungen löschen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα μοντέλα λαμβάνονται μία φορά και μετά λειτουργούν πλήρως εκτός σύνδεσης. Μπορείτε να τα διαγράψετε οποτεδήποτε στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos se descargan una sola vez y luego funcionan totalmente sin conexión. Puedes eliminarlos cuando quieras en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles se téléchargent une seule fois, puis fonctionnent entièrement hors ligne. Vous pouvez les supprimer à tout moment dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli si scaricano una sola volta e poi funzionano completamente offline. Puoi eliminarli in qualsiasi momento in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルは一度ダウンロードすれば、その後は完全にオフラインで動作します。設定でいつでも削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델은 한 번만 다운로드하면 이후 완전히 오프라인으로 작동합니다. 설정에서 언제든지 삭제할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos são baixados uma vez e depois funcionam totalmente offline. Você pode apagá-los a qualquer momento nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели скачиваются один раз и затем работают полностью офлайн. Их можно удалить в любой момент в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Моделі завантажуються один раз і далі працюють повністю офлайн. Їх можна будь-коли видалити в Налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "模型只需下載一次，之後就可以完全離線使用。你可以隨時在設定中刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型只需下载一次，之后即可完全离线使用。您可以随时在设置中删除。"
          }
        }
      }
    },
