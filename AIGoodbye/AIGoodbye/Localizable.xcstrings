    "Plays a short tone when the microphone opens and closes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt einen kurzen Ton ab, wenn das Mikrofon an- und ausgeht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παίζει έναν σύντομο ήχο όταν το μικρόφωνο ανοίγει και κλείνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce un tono corto cuando el micrófono se abre y se cierra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Émet un bref signal sonore quand le micro s'ouvre et se ferme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce un breve suono quando il microfono si apre e si chiude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクのオン・オフ時に短い音を鳴らします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 켜지고 꺼질 때 짧은 알림음을 재생합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca um som curto quando o microfone abre e fecha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий сигнал, когда микрофон включается и выключается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Короткий сигнал, коли мікрофон вмикається і вимикається."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風開同閂嗰陣會播一下短提示音。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风开启和关闭时播放简短提示音。"
          }
        }
      }
    },
