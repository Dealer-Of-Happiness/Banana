    "Reset all settings?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Einstellungen zurücksetzen?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επαναφορά όλων των ρυθμίσεων;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Restablecer todos los ajustes?"
          }
        },
