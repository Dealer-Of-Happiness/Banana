    "Live camera needs the %@ vision model. Download it from the chat screen first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Live-Kamera braucht das Vision-Modell %@. Lade es zuerst im Chat-Bildschirm herunter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η ζωντανή κάμερα χρειάζεται το μοντέλο όρασης %@. Κατεβάστε το πρώτα από την οθόνη συνομιλίας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara en vivo necesita el modelo de visión %@. Descárgalo primero desde la pantalla de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra en direct nécessite le modèle de vision %@. Téléchargez-le d'abord depuis l'écran de discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera live richiede il modello di visione %@. Scaricalo prima dalla schermata della chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブカメラには%@ビジョンモデルが必要です。先にチャット画面からダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브 카메라에는 %@ 비전 모델이 필요합니다. 먼저 채팅 화면에서 다운로드하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera ao vivo precisa do modelo de visão %@. Baixe-o primeiro na tela de chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для живой камеры нужна модель зрения %@. Сначала загрузите её на экране чата."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для живої камери потрібна модель зору %@. Спершу завантажте її на екрані чату."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "即時相機需要 %@ 視覺模型。請先喺傾偈畫面下載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时相机需要 %@ 视觉模型。请先在聊天界面下载。"
          }
        }
      }
    },
