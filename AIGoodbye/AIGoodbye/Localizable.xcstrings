          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать загрузку. Проверьте подключение к интернету и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося почати завантаження. Перевірте підключення до інтернету та спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開始唔到下載。請檢查網絡連線再試多次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始下载。请检查网络连接后重试。"
          }
        }
      }
    },
    "The microphone couldn't be started. Check that another app isn't using it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon konnte nicht gestartet werden. Prüfe, ob eine andere App es verwendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η εκκίνηση του μικροφώνου. Ελέγξτε αν το χρησιμοποιεί άλλη εφαρμογή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el micrófono. Comprueba que otra app no lo esté usando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer le micro. Vérifiez qu'une autre app ne l'utilise pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il microfono. Controlla che un'altra app non lo stia usando."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを起動できませんでした。他のアプリが使用中でないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크를 시작할 수 없습니다. 다른 앱이 사용 중인지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o microfone. Verifique se outro app não o está usando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить микрофон. Убедитесь, что его не использует другое приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося запустити мікрофон. Переконайтеся, що його не використовує інший застосунок."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開唔到麥克風。請檢查係咪有其他App用緊。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动麦克风。请检查是否有其他应用正在使用。"
          }
        }
      }
    },
    "The model isn't downloaded yet, so your message wasn't answered.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell ist noch nicht geladen, daher wurde deine Nachricht nicht beantwortet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο δεν έχει κατέβει ακόμη, οπότε το μήνυμά σας δεν απαντήθηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo aún no está descargado, así que tu mensaje no recibió respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle n'est pas encore téléchargé, votre message est donc resté sans réponse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello non è ancora scaricato, quindi il tuo messaggio non ha ricevuto risposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルがまだダウンロードされていないため、メッセージへの回答はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 아직 다운로드되지 않아 메시지에 답변하지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo ainda não foi baixado, então sua mensagem não foi respondida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ещё не загружена, поэтому на ваше сообщение нет ответа."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ще не завантажена, тому на ваше повідомлення немає відповіді."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "模型仲未下載，所以你嘅訊息仲未有回覆。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型尚未下载，因此您的消息还没有回复。"
          }
        }
      }
    },
    "The summary couldn't be made right now. The recording and transcript are safe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenfassung konnte gerade nicht erstellt werden. Aufnahme und Transkript sind sicher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δημιουργία περίληψης αυτή τη στιγμή. Η ηχογράφηση και η απομαγνητοφώνηση είναι ασφαλείς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se pudo crear el resumen. La grabación y la transcripción están a salvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résumé n'a pas pu être créé pour le moment. L'enregistrement et la transcription sont intacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare il riassunto in questo momento. La registrazione e la trascrizione sono al sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、要約を作成できませんでした。録音と文字起こしは保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 요약을 만들지 못했습니다. 녹음과 텍스트 기록은 안전합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o resumo agora. A gravação e a transcrição estão salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось составить резюме. Запись и расшифровка сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося створити підсумок. Запис і розшифровка збережені."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法產生摘要。錄音和文字記錄均已保存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法生成摘要。录音和文字记录均已保存。"
          }
        }
      }
    },
    "The summary couldn't be made right now. The recording and transcript are saved, and you can summarize it later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenfassung konnte gerade nicht erstellt werden. Aufnahme und Transkript sind gesichert – du kannst später zusammenfassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δημιουργία περίληψης αυτή τη στιγμή. Η ηχογράφηση και η απομαγνητοφώνηση αποθηκεύτηκαν και μπορείς να κάνεις περίληψη αργότερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se pudo crear el resumen. La grabación y la transcripción están guardadas y puedes resumirla más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résumé n'a pas pu être créé pour le moment. L'enregistrement et la transcription sont enregistrés, vous pourrez résumer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare il riassunto in questo momento. La registrazione e la trascrizione sono salvate e potrai riassumerla più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、要約を作成できませんでした。録音と文字起こしは保存済みで、あとから要約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 요약을 만들지 못했습니다. 녹음과 텍스트 기록은 저장되었으며 나중에 요약할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o resumo agora. A gravação e a transcrição foram salvas e você pode resumir depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось составить резюме. Запись и расшифровка сохранены — резюме можно создать позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося створити підсумок. Запис і розшифровка збережені — підсумок можна створити пізніше."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法產生摘要。錄音和文字記錄已保存，你可以稍後再產生摘要。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法生成摘要。录音和文字记录已保存，你可以稍后再生成摘要。"
          }
        }
      }
    },
