    "No readable text was found in this scan. Try again with more light, or hold the camera steady.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Scan wurde kein lesbarer Text gefunden. Versuche es mit mehr Licht oder halte die Kamera ruhig."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε αναγνώσιμο κείμενο σε αυτή τη σάρωση. Δοκίμασε ξανά με περισσότερο φως ή κράτησε σταθερή την κάμερα."
          }
