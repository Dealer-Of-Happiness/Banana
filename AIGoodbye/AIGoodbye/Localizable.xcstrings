    "Recording paused because another app needed the microphone. It will continue automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme pausiert, weil eine andere App das Mikrofon brauchte. Sie wird automatisch fortgesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η εγγραφή διακόπηκε επειδή μια άλλη εφαρμογή χρειάστηκε το μικρόφωνο. Θα συνεχιστεί αυτόματα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabación se ha pausado porque otra app necesitaba el micrófono. Continuará automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement en pause : une autre app avait besoin du micro. Il reprendra automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione in pausa perché un'altra app aveva bisogno del microfono. Riprenderà automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリがマイクを使ったため録音を一時停止しました。自動的に再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱이 마이크를 사용해 녹음을 일시정지했습니다. 자동으로 다시 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravação foi pausada porque outro app precisou do microfone. Ela continuará automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись приостановлена: микрофон понадобился другому приложению. Она продолжится автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис призупинено: мікрофон знадобився іншому застосунку. Він продовжиться автоматично."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "另一個 App 用咗麥克風，錄音暫停咗，之後會自動繼續。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 App 占用了麦克风，录音已暂停，稍后会自动继续。"
          }
        }
      }
    },
