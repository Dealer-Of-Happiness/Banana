    "Downloading in the background. Your message will be answered when it finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird im Hintergrund geladen. Deine Nachricht wird beantwortet, sobald der Download fertig ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη συνεχίζεται στο παρασκήνιο. Το μήνυμά σου θα απαντηθεί μόλις ολοκληρωθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descargando en segundo plano. Tu mensaje se responderá cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargement en arrière-plan. Votre message recevra une réponse une fois le téléchargement terminé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Download in background. Il tuo messaggio riceverà una risposta al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでダウンロードしています。完了したらメッセージに回答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드에서 다운로드하는 중입니다. 완료되면 메시지에 답변합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixando em segundo plano. Sua mensagem será respondida quando terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка идёт в фоне. Ответ на сообщение появится, когда она завершится."
