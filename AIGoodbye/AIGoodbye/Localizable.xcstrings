    "The AI model isn't ready yet. Download or select a model in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das KI-Modell ist noch nicht bereit. Laden oder wählen Sie ein Modell in den Einstellungen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το μοντέλο AI δεν είναι έτοιμο ακόμα. Κάντε λήψη ή επιλέξτε ένα μοντέλο στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo de IA aún no está listo. Descarga o selecciona un modelo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle d'IA n'est pas encore prêt. Téléchargez ou sélectionnez un modèle dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello IA non è ancora pronto. Scarica o seleziona un modello in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIモデルの準備がまだできていません。設定でモデルをダウンロードまたは選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 모델이 아직 준비되지 않았습니다. 설정에서 모델을 다운로드하거나 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo de IA ainda não está pronto. Baixe ou selecione um modelo nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ИИ ещё не готова. Скачайте или выберите модель в Настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель ШІ ще не готова. Завантажте або виберіть модель у Налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 模型尚未就緒。請在設定中下載或選擇模型。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 模型尚未就绪。请在设置中下载或选择模型。"
          }
        }
      }
    },
    "The camera isn't available. Check camera permission in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist nicht verfügbar. Prüfe die Kameraberechtigung in der Einstellungen-App."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
