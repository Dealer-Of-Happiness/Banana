    "About %lld seconds of audio were dropped because the device couldn't keep up. The transcript is unaffected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwa %lld Sekunden Audio gingen verloren, weil das Gerät nicht mitkam. Das Transkript ist davon nicht betroffen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χάθηκαν περίπου %lld δευτερόλεπτα ήχου επειδή η συσκευή δεν πρόλαβε. Η απομαγνητοφώνηση δεν επηρεάστηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se perdieron unos %lld segundos de audio porque el dispositivo no pudo seguir el ritmo. La transcripción no se ve afectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %lld secondes d'audio ont été perdues car l'appareil n'a pas suivi. La transcription n'est pas affectée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %lld secondi di audio sono andati persi perché il dispositivo non riusciva a stare al passo. La trascrizione non è stata compromessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末が追いつかず、約%lld秒分の音声が失われました。文字起こしには影響ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 따라가지 못해 약 %lld초 분량의 오디오가 누락됐습니다. 텍스트 기록에는 영향이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca de %lld segundos de áudio foram perdidos porque o dispositivo não conseguiu acompanhar. A transcrição não foi afetada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примерно %lld секунд звука потеряно: устройство не успевало. На расшифровку это не повлияло."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приблизно %lld секунд звуку втрачено: пристрій не встигав. На розшифровку це не вплинуло."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置跟唔上，大約 %lld 秒錄音無咗。文字紀錄唔受影響。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备跟不上，约 %lld 秒音频丢失。文字记录不受影响。"
          }
        }
      }
    },
