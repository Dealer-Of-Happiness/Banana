        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download travou. Verifique sua conexão com a internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка остановилась. Проверьте подключение к интернету."
