          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 꺼져 있습니다. 내장 모델을 사용하려면 설정에서 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
