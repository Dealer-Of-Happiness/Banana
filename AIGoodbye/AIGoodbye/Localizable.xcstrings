          }
        }
      }
    },
    "This model needs about %lld GB of memory and this device has %lld GB. It would run out of memory.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell benötigt etwa %lld GB Arbeitsspeicher, dieses Gerät hat %lld GB. Der Speicher würde nicht reichen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το μοντέλο χρειάζεται περίπου %lld GB μνήμης και αυτή η συσκευή έχει %lld GB. Θα εξαντλούσε τη μνήμη."
          }
        },
        "en": {
