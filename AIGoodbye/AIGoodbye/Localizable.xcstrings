    "Added, but switched off: up to %lld documents can be on at once. Turn another one off to use it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzugefügt, aber ausgeschaltet: Es können höchstens %lld Dokumente gleichzeitig eingeschaltet sein. Schalte ein anderes aus, um es zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Προστέθηκε, αλλά απενεργοποιημένο: μπορούν να είναι ενεργά έως %lld έγγραφα ταυτόχρονα. Απενεργοποίησε ένα άλλο για να το χρησιμοποιήσεις."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added, but switched off: up to %lld documents can be on at once. Turn another one off to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadido, pero desactivado: solo pueden estar activos %lld documentos a la vez. Desactiva otro para usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouté, mais désactivé : au plus %lld documents peuvent être activés à la fois. Désactivez-en un autre pour l'utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunto, ma disattivato: possono essere attivi al massimo %lld documenti alla volta. Disattivane un altro per usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加されましたがオフになっています。一度にオンにできる書類は最大%lld件です。使うには別の書類をオフにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가되었지만 꺼져 있습니다. 한 번에 최대 %lld개의 문서만 켤 수 있습니다. 다른 문서를 끄면 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionado, mas desativado: no máximo %lld documentos podem estar ativos ao mesmo tempo. Desative outro para usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавлено, но выключено: одновременно могут быть включены не более %lld документов. Выключите другой, чтобы использовать этот."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додано, але вимкнено: одночасно можуть бути ввімкнені не більше %lld документів. Вимкніть інший, щоб використовувати цей."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入但已關閉：最多可同時開啟 %lld 個文件。關閉另一個就可以使用。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加但已关闭：最多可同时开启 %lld 个文档。关闭另一个即可使用。"
          }
        }
      }
    },
