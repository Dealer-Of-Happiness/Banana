        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы общаться приватно на этом устройстве, нужно один раз скачать %1$@ (%2$@). После этого всё работает офлайн."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
