            "state": "translated",
            "value": "%@ doit d'abord être téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve prima essere scaricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず%@をダウンロードする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 %@을(를) 다운로드해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso baixar %@ primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала необходимо скачать %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спочатку потрібно завантажити %@."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先下載 %@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先下载 %@。"
          }
        }
      }
    },
