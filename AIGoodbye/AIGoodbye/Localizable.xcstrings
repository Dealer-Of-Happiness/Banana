        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель уже добавлена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю модель уже додано."
          }
        },
        "zh-HK": {
