    "Nothing you say leaves this device": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts, was Sie sagen, verlässt dieses Gerät"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τίποτα από όσα λέτε δεν φεύγει από αυτή τη συσκευή"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo que dices sale de este dispositivo"
