    "Please keep the details below. They help us find the problem.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte lass die Angaben unten stehen. Sie helfen uns, das Problem zu finden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Παρακαλούμε κρατήστε τα στοιχεία παρακάτω. Μας βοηθούν να βρούμε το πρόβλημα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja los datos de abajo, por favor. Nos ayudan a encontrar el problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de laisser les informations ci-dessous. Elles nous aident à trouver le problème."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia i dettagli qui sotto, per favore. Ci aiutano a trovare il problema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の情報はそのまま残してください。問題を見つける手がかりになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 정보는 지우지 말아 주세요. 문제를 찾는 데 도움이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, mantenha os dados abaixo. Eles nos ajudam a encontrar o problema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, не удаляйте данные ниже. Они помогают нам найти проблему."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, не видаляйте дані нижче. Вони допомагають нам знайти проблему."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "請保留下面的資料，有助我們找出問題。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保留下面的信息，这有助于我们找到问题。"
          }
        }
      }
    },
