    "Recordings stay on this device and are excluded from backups.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmen bleiben auf diesem Gerät und werden nicht in Backups aufgenommen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι ηχογραφήσεις παραμένουν σε αυτή τη συσκευή και εξαιρούνται από τα αντίγραφα ασφαλείας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones permanecen en este dispositivo y se excluyen de las copias de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements restent sur cet appareil et sont exclus des sauvegardes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le registrazioni restano su questo dispositivo e sono escluse dai backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音はこの端末に留まり、バックアップには含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음은 이 기기에만 남으며 백업에서 제외됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações permanecem neste dispositivo e ficam fora dos backups."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи остаются на этом устройстве и не попадают в резервные копии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи залишаються на цьому пристрої та не потрапляють у резервні копії."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音保留在此裝置上，並且不包含在備份中。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音保留在此设备上，并且不包含在备份中。"
          }
        }
      }
    },
