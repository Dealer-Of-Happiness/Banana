        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό το μοντέλο χρειάζεται περίπου %lld GB μνήμης, ενώ οι εφαρμογές σε αυτό το iPhone μπορούν να χρησιμοποιήσουν περίπου %lld GB. Η μνήμη δεν θα έφτανε."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "This model needs about %1$lld GB of memory, and apps on this iPhone can use about %2$lld GB. It would run out of memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo necesita unos %lld GB de memoria y las apps de este iPhone pueden usar unos %lld GB. Se quedaría sin memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle nécessite environ %lld Go de mémoire, et les apps de cet iPhone peuvent en utiliser environ %lld Go. La mémoire serait insuffisante."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello richiede circa %lld GB di memoria, ma le app su questo iPhone possono usarne circa %lld GB. La memoria non basterebbe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルには約%lld GBのメモリが必要ですが、このiPhoneでアプリが使えるのは約%lld GBです。メモリが不足します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델에는 약 %lld GB의 메모리가 필요하지만, 이 iPhone에서 앱이 사용할 수 있는 메모리는 약 %lld GB입니다. 메모리가 부족해집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo precisa de cerca de %lld GB de memória, e os apps neste iPhone podem usar cerca de %lld GB. A memória não seria suficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этой модели нужно около %lld ГБ памяти, а приложениям на этом iPhone доступно около %lld ГБ. Памяти не хватит."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цій моделі потрібно близько %lld ГБ пам'яті, а застосункам на цьому iPhone доступно близько %lld ГБ. Пам'яті не вистачить."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "呢個模型需要大約 %lld GB 記憶體，但呢部 iPhone 上面嘅 App 只可以用大約 %lld GB。記憶體會唔夠。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型需要约 %lld GB 内存，而此 iPhone 上的 App 只能使用约 %lld GB。内存会不足。"
          }
        }
      }
    },
    "This permanently deletes all your chats and folders. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle deine Chats und Ordner dauerhaft gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει οριστικά όλες τις συνομιλίες και τους φακέλους σου. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todos tus chats y carpetas. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement toutes vos conversations et tous vos dossiers. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina definitivamente tutte le tue chat e cartelle. Non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのチャットとフォルダが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 채팅과 폴더가 영구적으로 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga permanentemente todas as suas conversas e pastas. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит все ваши чаты и папки. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить усі ваші чати й папки. Цю дію не можна скасувати."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除你的所有聊天和檔案夾。此操作無法復原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除你的所有聊天和文件夹。此操作无法撤销。"
          }
        }
      }
    },
    "This photo couldn't be loaded. Try a different one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht geladen werden. Versuch es mit einem anderen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η φόρτωση αυτής της φωτογραφίας. Δοκίμασε μια άλλη."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar esta foto. Prueba con otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo n'a pas pu être chargée. Essayez-en une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
