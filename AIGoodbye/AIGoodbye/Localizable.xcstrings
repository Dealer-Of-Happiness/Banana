          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "下載停咗。請檢查網絡連線。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载已停滞。请检查网络连接。"
          }
        }
      }
    },
