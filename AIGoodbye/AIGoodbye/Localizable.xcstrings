    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@, added by you from Hugging Face. Community models are not tested by us: quality, speed and language support vary, and some may not load at all.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, von dir aus Hugging Face hinzugefügt. Community-Modelle werden von uns nicht getestet: Qualität, Geschwindigkeit und Sprachunterstützung schwanken, und manche laden gar nicht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, προστέθηκε από εσένα από το Hugging Face. Τα μοντέλα της κοινότητας δεν ελέγχονται από εμάς: η ποιότητα, η ταχύτητα και η υποστήριξη γλωσσών ποικίλλουν και κάποια μπορεί να μη φορτώσουν καθόλου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, añadido por ti desde Hugging Face. No probamos los modelos de la comunidad: la calidad, la velocidad y el soporte de idiomas varían, y algunos ni siquiera se cargan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, ajouté par vous depuis Hugging Face. Les modèles de la communauté ne sont pas testés par nous : la qualité, la vitesse et la prise en charge des langues varient, et certains ne se chargent pas du tout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, aggiunto da te da Hugging Face. I modelli della community non sono testati da noi: qualità, velocità e supporto linguistico variano e alcuni potrebbero non caricarsi affatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（Hugging Face から自分で追加）。コミュニティのモデルは当社では検証していません。品質、速度、対応言語はさまざまで、まったく読み込めない場合もあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, Hugging Face에서 직접 추가한 모델입니다. 커뮤니티 모델은 저희가 검증하지 않습니다. 품질, 속도, 언어 지원이 제각각이며 아예 로드되지 않을 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, adicionado por você do Hugging Face. Modelos da comunidade não são testados por nós: qualidade, velocidade e suporte a idiomas variam, e alguns podem nem carregar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, добавлено вами с Hugging Face. Модели сообщества мы не тестируем: качество, скорость и поддержка языков разнятся, а некоторые вообще не загружаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, додано вами з Hugging Face. Моделі спільноти ми не тестуємо: якість, швидкість і підтримка мов різняться, а деякі взагалі не завантажуються."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，由你從 Hugging Face 加入。社群模型未經我們測試：品質、速度和語言支援各不相同，有些甚至無法載入。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，由你从 Hugging Face 添加。社区模型未经我们测试：质量、速度和语言支持各不相同，有些甚至无法加载。"
          }
        }
      }
    },
    "%lld": {
      "shouldTranslate": false
    },
    "%lld of %lld pages had no readable text and were left out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld von %2$lld Seiten enthielten keinen lesbaren Text und wurden weggelassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld από %2$lld σελίδες δεν είχαν αναγνώσιμο κείμενο και παραλείφθηκαν."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld of %2$lld pages had no readable text and were left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld páginas no tenían texto legible y se omitieron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld page(s) sur %2$lld ne contenaient aucun texte lisible et ont été ignorées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld pagine su %2$lld non contenevano testo leggibile e sono state escluse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lldページ中%1$lldページに読み取れる文字がなかったため、除外しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld페이지 중 %1$lld페이지에서 읽을 수 있는 텍스트가 없어 제외했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld páginas não tinham texto legível e foram omitidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На %1$lld из %2$lld страниц не найдено читаемого текста, они пропущены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На %1$lld із %2$lld сторінок не знайдено читабельного тексту, їх пропущено."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 頁之中有 %1$lld 頁冇可讀文字，已經略過。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld 页中有 %1$lld 页没有可读文字，已跳过。"
          }
        }
      }
    },
