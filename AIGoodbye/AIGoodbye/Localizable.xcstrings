    "%1$@ - %2$@": {},
    "%@ can't run on this engine.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kann auf dieser Engine nicht ausgeführt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no puede ejecutarse en este motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne peut pas s'exécuter sur ce moteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non può essere eseguito su questo motore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのエンジンでは実行できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não pode ser executado neste mecanismo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не может работать на этом движке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法在此引擎上运行。"
          }
        }
      }
    },
    "%@ needs to be downloaded first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muss zuerst geladen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero es necesario descargar %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ doit d'abord être téléchargé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deve prima essere scaricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず%@をダウンロードする必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso baixar %@ primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала необходимо скачать %@."
