        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 아직 이 기기에서 준비 중입니다. 몇 분 후에 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
