          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a IA roda no seu dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Весь ИИ работает на вашем устройстве"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увесь ШІ працює на вашому пристрої"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 AI 都在你的裝置上運行"
