          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라가 일시 중지되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera foi pausada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера приостановлена."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камеру призупинено."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "相機暫停咗。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机已暂停。"
          }
        }
      }
    },
    "The chats inside can be kept and moved out of the folder, or deleted with it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Chats darin können behalten und aus dem Ordner verschoben oder zusammen mit ihm gelöscht werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι συνομιλίες μέσα του μπορούν να διατηρηθούν και να μεταφερθούν εκτός φακέλου, ή να διαγραφούν μαζί του."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chats inside can be kept and moved out of the folder, or deleted with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los chats que contiene pueden conservarse y sacarse de la carpeta, o eliminarse con ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les discussions qu'il contient peuvent être conservées et sorties du dossier, ou supprimées avec lui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat al suo interno possono essere conservate e spostate fuori dalla cartella, oppure eliminate con essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中のチャットは残してフォルダの外に移動するか、フォルダと一緒に削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 안의 대화는 유지하여 폴더 밖으로 옮기거나, 폴더와 함께 삭제할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas dentro dela podem ser mantidas e movidas para fora da pasta, ou excluídas junto com ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты внутри можно оставить, переместив их из папки, или удалить вместе с ней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чати всередині можна залишити, перемістивши їх із папки, або видалити разом із нею."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "入面嘅對話可以保留並移出資料夾，或者隨資料夾一齊刪除。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的聊天可以保留并移出文件夹，也可以随文件夹一起删除。"
          }
        }
      }
    },
    "The connection timed out. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei der Verbindung. Bitte versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση έληξε λόγω χρονικού ορίου. Δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de conexión. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré. Veuillez réessayer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione scaduta. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がタイムアウトしました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 시간이 초과되었습니다. 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conexão expirou. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания подключения истекло. Повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час очікування з'єднання минув. Повторіть спробу."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "連線逾時。請再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接超时。请重试。"
          }
        }
      }
    },
    "The download couldn't be completed. Check that Wi-Fi is connected and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download konnte nicht abgeschlossen werden. Prüfe, ob WLAN verbunden ist, und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη δεν ολοκληρώθηκε. Έλεγξε ότι είσαι συνδεδεμένος σε Wi-Fi και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la descarga. Comprueba que el Wi-Fi esté conectado e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement n'a pas pu être terminé. Vérifiez que le Wi-Fi est connecté et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il download non è stato completato. Controlla che il Wi-Fi sia connesso e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードを完了できませんでした。Wi-Fiに接続されているか確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드를 완료할 수 없습니다. Wi-Fi가 연결되어 있는지 확인하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download não pôde ser concluído. Verifique se o Wi-Fi está conectado e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить загрузку. Проверьте подключение к Wi-Fi и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити завантаження. Перевірте підключення до Wi-Fi і спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "下載未能完成。請檢查 Wi-Fi 有冇連接，然後再試一次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载未能完成。请检查 Wi-Fi 是否已连接，然后重试。"
          }
        }
      }
    },
    "The download couldn't start. Check your internet connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download konnte nicht gestartet werden. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η έναρξη της λήψης. Έλεγξε τη σύνδεσή σου στο διαδίκτυο και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la descarga. Comprueba tu conexión a internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement n'a pas pu démarrer. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il download. Controlla la connessione a internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードを開始できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드를 시작할 수 없습니다. 인터넷 연결을 확인한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o download. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать загрузку. Проверьте подключение к интернету и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося почати завантаження. Перевірте підключення до інтернету та спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開始唔到下載。請檢查網絡連線再試多次。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法开始下载。请检查网络连接后重试。"
          }
        }
      }
    },
    "The library index couldn't be read, so nothing can be added until it is repaired. Restart the app and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bibliotheksindex konnte nicht gelesen werden, daher kann nichts hinzugefügt werden, bis er repariert ist. Starte die App neu und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η ανάγνωση του ευρετηρίου της βιβλιοθήκης, οπότε δεν μπορεί να προστεθεί τίποτα μέχρι να επισκευαστεί. Κάνε επανεκκίνηση της εφαρμογής και δοκίμασε ξανά."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The library index couldn't be read, so nothing can be added until it is repaired. Restart the app and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el índice de la biblioteca, así que no se puede añadir nada hasta que se repare. Reinicia la app e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'index de la bibliothèque n'a pas pu être lu : rien ne peut être ajouté tant qu'il n'est pas réparé. Redémarrez l'app et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l'indice della libreria, quindi non è possibile aggiungere nulla finché non viene riparato. Riavvia l'app e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリの索引を読み込めないため、修復されるまで何も追加できません。アプリを再起動してもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리 색인을 읽을 수 없어 복구될 때까지 아무것도 추가할 수 없습니다. 앱을 다시 시작한 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o índice da biblioteca, então nada pode ser adicionado até que ele seja reparado. Reinicie o app e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать индекс библиотеки, поэтому ничего нельзя добавить, пока он не будет восстановлен. Перезапустите приложение и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати індекс бібліотеки, тому нічого не можна додати, доки його не буде відновлено. Перезапустіть застосунок і спробуйте знову."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取資料庫索引，修復前無法加入任何內容。請重新啟動 App 再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取资料库索引，修复前无法添加任何内容。请重新启动应用后重试。"
          }
        }
      }
    },
    "The microphone couldn't be started. Check that another app isn't using it.": {
