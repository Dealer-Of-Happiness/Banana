    "The summary couldn't be made right now. The recording and transcript are safe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenfassung konnte gerade nicht erstellt werden. Aufnahme und Transkript sind sicher."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δημιουργία περίληψης αυτή τη στιγμή. Η ηχογράφηση και η απομαγνητοφώνηση είναι ασφαλείς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se pudo crear el resumen. La grabación y la transcripción están a salvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résumé n'a pas pu être créé pour le moment. L'enregistrement et la transcription sont intacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare il riassunto in questo momento. La registrazione e la trascrizione sono al sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、要約を作成できませんでした。録音と文字起こしは保存されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 요약을 만들지 못했습니다. 녹음과 텍스트 기록은 안전합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível criar o resumo agora. A gravação e a transcrição estão salvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас не удалось составить резюме. Запись и расшифровка сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося створити підсумок. Запис і розшифровка збережені."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "目前無法產生摘要。錄音和文字記錄均已保存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法生成摘要。录音和文字记录均已保存。"
          }
        }
      }
    },
    "The summary couldn't be made right now. The recording and transcript are saved, and you can summarize it later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zusammenfassung konnte gerade nicht erstellt werden. Aufnahme und Transkript sind gesichert – du kannst später zusammenfassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η δημιουργία περίληψης αυτή τη στιγμή. Η ηχογράφηση και η απομαγνητοφώνηση αποθηκεύτηκαν και μπορείς να κάνεις περίληψη αργότερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se pudo crear el resumen. La grabación y la transcripción están guardadas y puedes resumirla más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résumé n'a pas pu être créé pour le moment. L'enregistrement et la transcription sont enregistrés, vous pourrez résumer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile creare il riassunto in questo momento. La registrazione e la trascrizione sono salvate e potrai riassumerla più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、要約を作成できませんでした。録音と文字起こしは保存済みで、あとから要約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 요약을 만들지 못했습니다. 녹음과 텍스트 기록은 저장되었으며 나중에 요약할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
