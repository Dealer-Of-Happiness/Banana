          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se grabó nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été enregistré"
          }
        },
        "it": {
