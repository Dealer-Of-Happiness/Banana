    "Memory is off, so this wasn't saved. Turn it on in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gedächtnis ist aus, daher wurde das nicht gespeichert. Schalte es in den Einstellungen ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η μνήμη είναι απενεργοποιημένη, οπότε αυτό δεν αποθηκεύτηκε. Ενεργοποίησέ τη στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria está desactivada, así que esto no se guardó. Actívala en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mémoire est désactivée : cela n'a donc pas été enregistré. Activez-la dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria è disattivata, quindi non è stato salvato. Attivala nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶がオフのため、保存されませんでした。設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억이 꺼져 있어 저장되지 않았습니다. 설정에서 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A memória está desativada, então isso não foi salvo. Ative-a nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Память выключена, поэтому это не сохранено. Включите её в настройках."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пам'ять вимкнено, тому це не збережено. Увімкніть її в налаштуваннях."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "記憶已經閂咗，所以冇儲存。去設定開返佢。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记忆已关闭，因此未保存。请在设置中开启。"
          }
        }
      }
    },
