    "Download stalled. Check your internet connection.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Download hängt. Bitte Internetverbindung prüfen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η λήψη κόλλησε. Ελέγξτε τη σύνδεσή σας στο διαδίκτυο."
          }
        },
        "es": {
          "stringUnit": {
