    "Camera is not available on this device. Please use Photo Library instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera ist auf diesem Gerät nicht verfügbar. Verwenden Sie stattdessen die Fotomediathek."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η κάμερα δεν είναι διαθέσιμη σε αυτήν τη συσκευή. Χρησιμοποιήστε τη βιβλιοθήκη φωτογραφιών."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara no está disponible en este dispositivo. Usa la fototeca en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appareil photo n'est pas disponible sur cet appareil. Utilisez plutôt la photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera non è disponibile su questo dispositivo. Usa invece la libreria foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではカメラを利用できません。代わりにフォトライブラリを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 카메라를 사용할 수 없습니다. 대신 사진 보관함을 사용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera não está disponível neste dispositivo. Use a fototeca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна на этом устройстве. Используйте медиатеку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера недоступна на цьому пристрої. Скористайтеся медіатекою."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置無法使用相機。請改用相片圖庫。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的相机不可用。请改用照片图库。"
          }
