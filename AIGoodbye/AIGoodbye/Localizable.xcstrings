    "Up to %@ documents can be switched on at once, so answers stay fast.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es können bis zu %@ Dokumente gleichzeitig aktiv sein, damit Antworten schnell bleiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορούν να είναι ενεργά έως %@ έγγραφα ταυτόχρονα, ώστε οι απαντήσεις να παραμένουν γρήγορες."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes activar hasta %@ documentos a la vez para que las respuestas sigan siendo rápidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'à %@ documents peuvent être activés à la fois, pour que les réponses restent rapides."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi attivare fino a %@ documenti alla volta, così le risposte restano veloci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を速く保つため、同時に有効にできる書類は最大%@件です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변 속도를 유지하기 위해 한 번에 최대 %@개의 문서를 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
