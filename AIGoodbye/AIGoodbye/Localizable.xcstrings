    "There isn't enough free space to record. Free up some space and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nicht genug freier Speicher zum Aufnehmen vorhanden. Schaffe Platz und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει αρκετός ελεύθερος χώρος για εγγραφή. Ελευθέρωσε χώρο και δοκίμασε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio libre suficiente para grabar. Libera espacio e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas assez d'espace libre pour enregistrer. Libérez de l'espace et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è abbastanza spazio libero per registrare. Libera spazio e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するのに十分な空き容量がありません。空き容量を増やしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음할 여유 공간이 부족합니다. 공간을 확보한 뒤 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço livre suficiente para gravar. Libere espaço e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно свободного места для записи. Освободите место и попробуйте снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо вільного місця для запису. Звільніть місце та спробуйте ще раз."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空間不足，無法錄音。請釋放一些空間後重試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用空间不足，无法录音。请释放一些空间后重试。"
          }
        }
      }
    },
