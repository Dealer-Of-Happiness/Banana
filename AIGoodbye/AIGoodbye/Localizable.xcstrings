    "Downloaded by iOS from Apple the first time you speak or record in a language": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden von iOS bei Apple geladen, wenn du zum ersten Mal in einer Sprache sprichst oder aufnimmst"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα κατεβάζει το iOS από την Apple την πρώτη φορά που μιλάς ή ηχογραφείς σε μια γλώσσα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS los descarga de Apple la primera vez que hablas o grabas en un idioma"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargés par iOS depuis Apple la première fois que vous parlez ou enregistrez dans une langue"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaricati da iOS dai server Apple la prima volta che parli o registri in una lingua"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ある言語で初めて話したり録音したりしたときに、iOSがAppleからダウンロードします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 언어로 처음 말하거나 녹음할 때 iOS가 Apple에서 다운로드합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixados pelo iOS da Apple na primeira vez que você fala ou grava em um idioma"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS скачивает их с серверов Apple, когда вы впервые говорите или записываете на каком-либо языке"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS завантажує їх з Apple, коли ви вперше говорите або записуєте певною мовою"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次用某種語言講嘢或者錄音嗰陣，由 iOS 從 Apple 下載"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次用某种语言说话或录音时，由 iOS 从 Apple 下载"
          }
        }
      }
    },
