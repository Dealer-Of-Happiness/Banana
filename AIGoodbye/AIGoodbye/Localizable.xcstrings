    "Private, on-device AI. Works offline, no subscriptions, your conversations never leave your device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Private KI direkt auf dem Gerät. Funktioniert offline, keine Abos, und deine Unterhaltungen verlassen dein Gerät nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ιδιωτικό AI στη συσκευή. Λειτουργεί εκτός σύνδεσης, χωρίς συνδρομές, και οι συνομιλίες σου δεν φεύγουν ποτέ από τη συσκευή σου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IA privada en el dispositivo. Funciona sin conexión, sin suscripciones, y tus conversaciones nunca salen de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "IA privée, sur l'appareil. Fonctionne hors ligne, sans abonnement, et vos conversations ne quittent jamais votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "IA privata, sul dispositivo. Funziona offline, senza abbonamenti, e le tue conversazioni non lasciano mai il dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内で動くプライベート AI。オフラインで動作し、サブスクリプションはなく、会話が端末の外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기에서 실행되는 비공개 AI. 오프라인으로 작동하고, 구독이 없으며, 대화가 기기를 벗어나지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "IA privada, no dispositivo. Funciona off-line, sem assinaturas, e suas conversas nunca saem do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватный ИИ прямо на устройстве. Работает офлайн, без подписок, и ваши переписки никогда не покидают устройство."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватний ШІ просто на пристрої. Працює офлайн, без підписок, і ваші розмови ніколи не залишають пристрій."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "在裝置本機執行的私密 AI。可離線使用，無訂閱，你的對話永遠不會離開裝置。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备本机运行的私密 AI。可离线使用，无订阅，你的对话永远不会离开设备。"
          }
        }
      }
    },
