    },
    "The audio device changed, so only the transcript continues from here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audiogerät hat gewechselt, ab hier wird nur noch das Transkript fortgesetzt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή ήχου άλλαξε, οπότε από εδώ και πέρα συνεχίζει μόνο η απομαγνητοφώνηση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo de audio cambió, así que a partir de aquí solo continúa la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le périphérique audio a changé : à partir d'ici, seule la transcription continue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo audio è cambiato, quindi da qui in poi continua solo la trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオ機器が変わったため、ここからは文字起こしのみ続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 기기가 바뀌어 여기부터는 텍스트 기록만 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo de áudio mudou, então daqui em diante só a transcrição continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудиоустройство изменилось, поэтому дальше сохраняется только расшифровка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіопристрій змінився, тому далі зберігається лише розшифровка."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊裝置已變更，從此處開始僅繼續記錄文字。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频设备已更改，从此处开始仅继续记录文字。"
          }
        }
      }
    },
    "The audio device changed, so recording paused. Tap resume to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audiogerät hat gewechselt, daher wurde die Aufnahme pausiert. Tippe auf „Fortsetzen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή ήχου άλλαξε, οπότε η εγγραφή τέθηκε σε παύση. Πάτησε «Συνέχεια»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo de audio cambió, así que la grabación se pausó. Toca «Reanudar» para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le périphérique audio a changé, l'enregistrement est en pause. Touchez « Reprendre »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo audio è cambiato, quindi la registrazione è in pausa. Tocca «Riprendi»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオ機器が変わったため録音を一時停止しました。「再開」をタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 기기가 바뀌어 녹음을 일시정지했습니다. ‘계속’을 눌러 이어가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo de áudio mudou, então a gravação foi pausada. Toque em «Retomar»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудиоустройство изменилось, поэтому запись приостановлена. Нажмите «Продолжить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіопристрій змінився, тому запис призупинено. Натисніть «Продовжити»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊裝置已變更，錄音已暫停。點一下「繼續」以繼續錄音。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频设备已更改，录音已暂停。点按“继续”以继续录音。"
          }
        }
      }
    },
    "The audio device changed. Recording continued.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audiogerät hat gewechselt. Die Aufnahme läuft weiter."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η συσκευή ήχου άλλαξε. Η εγγραφή συνεχίστηκε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo de audio ha cambiado. La grabación ha continuado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le périphérique audio a changé. L'enregistrement s'est poursuivi."
          }
        },
        "it": {
