    "AiGoodbye is free. There are no subscriptions, no in-app purchases and no ads.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ist kostenlos. Keine Abos, keine In-App-Käufe und keine Werbung."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye είναι δωρεάν. Χωρίς συνδρομές, χωρίς αγορές μέσα στην εφαρμογή και χωρίς διαφημίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye es gratis. Sin suscripciones, sin compras dentro de la app y sin anuncios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye est gratuit. Pas d’abonnement, pas d’achats intégrés et pas de publicité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye è gratis. Niente abbonamenti, niente acquisti in-app e niente pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeは無料です。サブスクリプションも、App内課金も、広告もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye는 무료입니다. 구독도, 앱 내 구입도, 광고도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye é gratuito. Sem assinaturas, sem compras no app e sem anúncios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye бесплатен. Никаких подписок, встроенных покупок и рекламы."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye безкоштовний. Жодних підписок, вбудованих покупок і реклами."
          }
        },
