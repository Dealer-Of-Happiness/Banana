    "Ask questions, analyze images, or discuss documents. Everything stays on your device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle Fragen, analysiere Bilder oder bespreche Dokumente. Alles bleibt auf deinem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Κάντε ερωτήσεις, αναλύστε εικόνες ή συζητήστε έγγραφα. Όλα μένουν στη συσκευή σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz preguntas, analiza imágenes o comenta documentos. Todo se queda en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez des questions, analysez des images ou discutez de documents. Tout reste sur votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai domande, analizza immagini o discuti documenti. Tutto resta sul tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問したり、画像を分析したり、書類について話したり。すべてはあなたのデバイスの中に留まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문하고, 이미지를 분석하고, 문서에 대해 대화하세요. 모든 것이 기기 안에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça perguntas, analise imagens ou converse sobre documentos. Tudo fica no seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задавайте вопросы, анализируйте изображения и обсуждайте документы. Всё остаётся на вашем устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставте запитання, аналізуйте зображення й обговорюйте документи. Усе залишається на вашому пристрої."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "提問、分析圖片、傾吓文件。一切都留喺你部裝置度。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问、分析图片、讨论文档。一切都保留在您的设备上。"
          }
        }
      }
    },
