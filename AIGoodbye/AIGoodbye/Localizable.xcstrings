    "This frees %@ right away. %@ is your current model, so it will be re-downloaded the next time you use it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gibt sofort %1$@ frei. %2$@ ist dein aktuelles Modell und wird bei der nächsten Nutzung erneut geladen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό ελευθερώνει αμέσως %1$@. Το %2$@ είναι το τρέχον μοντέλο σας, οπότε θα κατέβει ξανά την επόμενη φορά που θα το χρησιμοποιήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto libera %1$@ de inmediato. %2$@ es tu modelo actual, así que se volverá a descargar la próxima vez que lo uses."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela libère %1$@ immédiatement. %2$@ est votre modèle actuel, il sera donc retéléchargé à la prochaine utilisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo libera subito %1$@. %2$@ è il tuo modello attuale, quindi verrà scaricato di nuovo al prossimo utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに%1$@が解放されます。%2$@は現在使用中のモデルのため、次回使用時に再ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 %1$@가 확보됩니다. %2$@은(는) 현재 사용 중인 모델이므로 다음에 사용할 때 다시 다운로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso libera %1$@ imediatamente. %2$@ é seu modelo atual, então será baixado de novo na próxima vez que você usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сразу освободит %1$@. %2$@ — ваша текущая модель, поэтому при следующем использовании она будет загружена заново."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це одразу звільнить %1$@. %2$@ — ваша поточна модель, тому наступного разу її буде завантажено знову."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "咁樣即刻釋放 %1$@。%2$@ 係你而家用緊嘅模型，下次用嘅時候會重新下載。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将立即释放 %1$@。%2$@ 是您当前的模型，下次使用时会重新下载。"
          }
        }
      }
    },
    "This frees %@ right away. You can download %@ again anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gibt sofort %1$@ frei. Du kannst %2$@ jederzeit erneut laden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό ελευθερώνει αμέσως %1$@. Μπορείτε να κατεβάσετε ξανά το %2$@ οποιαδήποτε στιγμή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto libera %1$@ de inmediato. Puedes volver a descargar %2$@ cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela libère %1$@ immédiatement. Vous pouvez retélécharger %2$@ à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo libera subito %1$@. Puoi scaricare di nuovo %2$@ quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すぐに%1$@が解放されます。%2$@はいつでも再ダウンロードできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 %1$@가 확보됩니다. %2$@은(는) 언제든지 다시 다운로드할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso libera %1$@ imediatamente. Você pode baixar %2$@ de novo a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это сразу освободит %1$@. Вы можете снова загрузить %2$@ в любой момент."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це одразу звільнить %1$@. Ви можете знову завантажити %2$@ будь-коли."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "咁樣即刻釋放 %1$@。你可以隨時再下載 %2$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将立即释放 %1$@。您可以随时重新下载 %2$@。"
          }
        }
      }
    },
    "This permanently deletes all your chats and folders. This cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Ihre Chats und Ordner dauerhaft gelöscht. Dies kann nicht widerrufen werden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτό διαγράφει οριστικά όλες τις συνομιλίες και τους φακέλους σας. Αυτό δεν μπορεί να αναιρεθεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina permanentemente todos tus chats y carpetas. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime définitivement toutes vos conversations et tous vos dossiers. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione elimina definitivamente tutte le tue chat e cartelle. Non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのチャットとフォルダが完全に削除されます。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 채팅과 폴더가 영구적으로 삭제됩니다. 이 동작은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga permanentemente todas as suas conversas e pastas. Não é possível desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это навсегда удалит все ваши чаты и папки. Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить усі ваші чати й папки. Цю дію не можна скасувати."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "這會永久刪除你的所有聊天和檔案夾。此操作無法復原。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除您的所有聊天和文件夹。此操作无法撤销。"
          }
        }
      }
    },
    "This photo couldn't be loaded. Try a different one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht geladen werden. Versuchen Sie ein anderes."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν ήταν δυνατή η φόρτωση αυτής της φωτογραφίας. Δοκιμάστε μια διαφορετική."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar esta foto. Prueba con otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette photo n'a pas pu être chargée. Essayez-en une autre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile caricare questa foto. Provane un'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を読み込めませんでした。別の写真をお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사진을 불러오지 못했습니다. 다른 사진을 사용해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar esta foto. Tente outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить это фото. Попробуйте другое."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити це фото. Спробуйте інше."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "無法載入此相片。請試試另一張。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法载入此照片。请试试其他照片。"
          }
        }
      }
    },
    "This photo couldn't be read. Try a different one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Foto konnte nicht gelesen werden. Versuchen Sie ein anderes."
