    "AiGoodbye": {
      "shouldTranslate": false
    },
    "AiGoodbye is busy with another task. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ist mit einer anderen Aufgabe beschäftigt. Versuche es gleich noch einmal."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye είναι απασχολημένο με άλλη εργασία. Δοκίμασε ξανά σε λίγο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye está ocupado con otra tarea. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye est occupé par une autre tâche. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye è occupato con un'altra attività. Riprova tra un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye は別の処理を実行中です。少し待ってからお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye가 다른 작업을 처리 중입니다. 잠시 후 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye está ocupado com outra tarefa. Tente novamente em instantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye занят другой задачей. Повторите попытку через мгновение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye зайнятий іншим завданням. Спробуйте ще раз за мить."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 正在處理其他任務。請稍後再試。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 正在处理其他任务。请稍后再试。"
          }
        }
      }
    },
    "AiGoodbye is locked. Siri can answer while the app is open and unlocked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ist gesperrt. Siri kann antworten, solange die App geöffnet und entsperrt ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye είναι κλειδωμένο. Το Siri μπορεί να απαντά όσο η εφαρμογή είναι ανοιχτή και ξεκλείδωτη."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye is locked. Siri can answer while the app is open and unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye está bloqueada. Siri puede responder mientras la app esté abierta y desbloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye est verrouillé. Siri peut répondre tant que l'app est ouverte et déverrouillée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye è bloccata. Siri può rispondere mentre l'app è aperta e sbloccata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeはロックされています。アプリを開いてロックを解除している間はSiriが回答できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye가 잠겨 있습니다. 앱이 열려 있고 잠금이 해제된 동안에는 Siri가 답할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye está bloqueado. A Siri pode responder enquanto o app estiver aberto e desbloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye заблокировано. Siri может отвечать, пока приложение открыто и разблокировано."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye заблоковано. Siri може відповідати, поки застосунок відкритий і розблокований."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 已鎖定。App 開啟並解鎖時，Siri 先可以回答。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 已锁定。应用打开且已解锁时，Siri 才能回答。"
          }
        }
      }
    },
    "AiGoodbye needs microphone access for voice conversations. You can enable it in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye braucht Zugriff auf das Mikrofon für Sprachgespräche. Du kannst ihn in der Einstellungen-App erlauben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρειάζεται πρόσβαση στο μικρόφωνο για φωνητικές συνομιλίες. Μπορείς να την ενεργοποιήσεις στην εφαρμογή Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye necesita acceso al micrófono para las conversaciones por voz. Puedes activarlo en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye a besoin d'accéder au micro pour les conversations vocales. Vous pouvez l'autoriser dans l'app Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ha bisogno dell'accesso al microfono per le conversazioni vocali. Puoi attivarlo nell'app Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声会話にはAiGoodbyeがマイクにアクセスする必要があります。設定アプリで許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 대화를 하려면 AiGoodbye에 마이크 접근 권한이 필요합니다. 설정 앱에서 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye precisa de acesso ao microfone para conversas por voz. Você pode ativá-lo no app Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосовых разговоров AiGoodbye нужен доступ к микрофону. Его можно включить в приложении «Настройки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для голосових розмов AiGoodbye потрібен доступ до мікрофона. Його можна увімкнути в застосунку «Параметри»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "語音對話需要 AiGoodbye 取用麥克風。你可以喺「設定」App 入面開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音对话需要 AiGoodbye 访问麦克风。你可以在“设置”App 中开启。"
          }
        }
      }
    },
    "AiGoodbye needs microphone access to record. You can enable it in the Settings app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye benötigt Zugriff auf das Mikrofon, um aufzunehmen. Du kannst ihn in der App „Einstellungen“ aktivieren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye χρειάζεται πρόσβαση στο μικρόφωνο για να ηχογραφεί. Μπορείς να την ενεργοποιήσεις στις Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye necesita acceso al micrófono para grabar. Puedes activarlo en la app Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye a besoin d'accéder au micro pour enregistrer. Vous pouvez l'autoriser dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye ha bisogno dell'accesso al microfono per registrare. Puoi attivarlo in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音するには、AiGoodbye にマイクへのアクセスが必要です。「設定」アプリで許可できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음하려면 AiGoodbye에 마이크 권한이 필요합니다. 설정 앱에서 켤 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye precisa de acesso ao microfone para gravar. Você pode ativar nos Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для записи AiGoodbye нужен доступ к микрофону. Включить его можно в приложении «Настройки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для запису AiGoodbye потрібен доступ до мікрофона. Увімкнути його можна в застосунку «Параметри»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 需要麥克風權限才能錄音。你可以在「設定」中開啟。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 需要麦克风权限才能录音。你可以在“设置”中开启。"
          }
        }
      }
    },
    "AiGoodbye stopped while a recording was in progress. What was captured up to that point can be saved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye wurde während einer laufenden Aufnahme beendet. Was bis dahin aufgezeichnet wurde, lässt sich sichern."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το AiGoodbye σταμάτησε ενώ γινόταν εγγραφή. Ό,τι καταγράφηκε μέχρι εκείνη τη στιγμή μπορεί να αποθηκευτεί."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye se detuvo mientras había una grabación en curso. Lo capturado hasta ese momento se puede guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye s'est arrêté pendant un enregistrement. Ce qui a été capté jusque-là peut être conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye si è interrotta durante una registrazione. Quanto acquisito fino a quel momento può essere salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音中にAiGoodbyeが停止しました。そこまでに記録された内容は保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음 중에 AiGoodbye가 중단됐습니다. 그때까지 기록된 내용은 저장할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O AiGoodbye parou durante uma gravação. O que foi captado até ali pode ser salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye остановился во время записи. Всё, что записано до этого момента, можно сохранить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye зупинився під час запису. Усе, що записано до цього моменту, можна зберегти."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 喺錄音途中停咗。之前錄到嘅內容可以保存。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye 在录音过程中停止了。此前录到的内容可以保存。"
          }
        }
      }
    },
