    "Audio and transcripts stay on this device and are left out of iCloud backup": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio und Transkripte bleiben auf diesem Gerät und sind vom iCloud-Backup ausgeschlossen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος και οι απομαγνητοφωνήσεις μένουν σε αυτή τη συσκευή και εξαιρούνται από το αντίγραφο ασφαλείας iCloud"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio y las transcripciones se quedan en este dispositivo y no se incluyen en la copia de seguridad de iCloud"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio et les transcriptions restent sur cet appareil et sont exclus de la sauvegarde iCloud"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio e trascrizioni restano su questo dispositivo e sono esclusi dal backup di iCloud"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声と文字起こしはこのデバイスに保存され、iCloudバックアップには含まれません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오와 텍스트 기록은 이 기기에만 남고 iCloud 백업에서 제외됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio e as transcrições ficam neste dispositivo e não entram no backup do iCloud"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио и расшифровки остаются на этом устройстве и не попадают в резервную копию iCloud"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіо та розшифровки залишаються на цьому пристрої й не потрапляють до резервної копії iCloud"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊同文字記錄只會留喺呢部裝置，唔會包括喺 iCloud 備份入面"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频和文字记录保留在此设备上，且不包含在 iCloud 备份中"
          }
        }
      }
    },
    "Audio was interrupted, so recording paused. Tap resume to continue.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiowiedergabe wurde unterbrochen, daher wurde die Aufnahme pausiert. Tippe auf „Fortsetzen“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο ήχος διακόπηκε, οπότε η εγγραφή τέθηκε σε παύση. Πάτησε «Συνέχεια» για να συνεχίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio se interrumpió, así que la grabación se pausó. Toca «Reanudar» para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio a été interrompu, l'enregistrement est donc en pause. Touchez « Reprendre » pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio è stato interrotto, quindi la registrazione è in pausa. Tocca «Riprendi» per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声が中断されたため録音を一時停止しました。「再開」をタップして続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 중단되어 녹음을 일시정지했습니다. ‘계속’을 눌러 이어가세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio foi interrompido, então a gravação foi pausada. Toque em «Retomar» para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук был прерван, поэтому запись приостановлена. Нажмите «Продолжить»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук було перервано, тому запис призупинено. Натисніть «Продовжити»."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊被中斷，錄音已暫停。點一下「繼續」以繼續錄音。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频被中断，录音已暂停。点按“继续”以继续录音。"
          }
        }
      }
    },
