            "state": "translated",
            "value": "Nada lembrado ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего не запомнено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки що нічого не запам'ятовано."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "仲未記住任何嘢。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有记住任何内容。"
          }
        }
      }
    },
    "Nothing to describe yet.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zu beschreiben."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχει κάτι να περιγραφεί ακόμα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que describir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à décrire pour l'instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente da descrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ説明できるものがありません。"
          }
        },
        "ko": {
