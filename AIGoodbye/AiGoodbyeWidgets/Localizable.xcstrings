    "Hear what the camera sees.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör, was die Kamera sieht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άκου τι βλέπει η κάμερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha lo que ve la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoutez ce que voit l'appareil photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ascolta ciò che vede la fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラに映るものを音声で聞けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라에 보이는 것을 들어 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouça o que a câmera vê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слушайте, что видит камера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слухайте, що бачить камера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "听听相机看到了什么。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "聽吓相機見到乜嘢。"
          }
        }
      }
    },
    "Open the meeting recorder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne die Meeting-Aufnahme."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Άνοιξε την εγγραφή συσκέψεων."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la grabadora de reuniones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez l'enregistreur de réunions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri il registratore di riunioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議レコーダーを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의 녹음기를 엽니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o gravador de reuniões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте диктофон для встреч."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте диктофон для зустрічей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开会议录音。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟會議錄音。"
          }
        }
      }
    },
    "Opens AiGoodbye and describes what the camera sees, out loud.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet AiGoodbye und beschreibt laut, was die Kamera sieht."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει το AiGoodbye και περιγράφει φωναχτά ό,τι βλέπει η κάμερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre AiGoodbye y describe en voz alta lo que ve la cámara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre AiGoodbye et décrit à voix haute ce que voit l'appareil photo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre AiGoodbye e descrive ad alta voce ciò che vede la fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbyeを開き、カメラに映っているものを声で説明します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AiGoodbye를 열고 카메라에 보이는 것을 소리 내어 설명합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o AiGoodbye e descreve em voz alta o que a câmera vê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает AiGoodbye и вслух описывает то, что видит камера."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває AiGoodbye і вголос описує те, що бачить камера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 AiGoodbye，并朗读描述相机看到的内容。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟 AiGoodbye，讀出相機見到嘅嘢。"
          }
        }
      }
    },
    "Opens AiGoodbye and starts a voice conversation.": {
