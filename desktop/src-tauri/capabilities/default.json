{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "Default capabilities for AIGoodbye",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/ollama",
          "sidecar": true,
          "args": true
        },
        {
          "name": "powershell",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ollama",
          "sidecar": true,
          "args": true
        },
        {
          "name": "powershell",
          "args": true
        }
      ]
    },
    "fs:default",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read",
    "fs:allow-write",
    {
      "identifier": "fs:scope",
      "allow": [
        "$APPLOCALDATA/**"
      ]
    },
    "dialog:default",
    "notification:default",
    "process:default",
    "process:allow-restart",
    "updater:default"
  ]
}
