<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>DOH AI</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <true/>
    </dict>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
        <key>UIImageName</key>
        <string>LaunchIcon</string>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <!-- Privacy Usage Descriptions -->
    <key>NSCameraUsageDescription</key>
    <string>DOH AI uses the camera to analyze photos and documents</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>DOH AI uses the microphone for voice conversations</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>DOH AI uses speech recognition to understand your voice commands</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>DOH AI accesses photos for image analysis</string>
    <key>NSCalendarsUsageDescription</key>
    <string>DOH AI accesses your calendar to help manage your schedule</string>
    <key>NSRemindersUsageDescription</key>
    <string>DOH AI accesses reminders to help you stay organized</string>
    <key>NSHealthShareUsageDescription</key>
    <string>DOH AI reads health data to provide personalized insights</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>DOH AI does not write health data</string>

    <!-- File Sharing -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <true/>
    <key>UISupportsDocumentBrowser</key>
    <true/>

    <!-- Export Compliance -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- URL Schemes for Widgets -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>dohai</string>
            </array>
            <key>CFBundleURLName</key>
            <string>com.dohai.app</string>
        </dict>
    </array>

    <!-- Background Modes -->
    <key>UIBackgroundModes</key>
    <array>
        <string>audio</string>
        <string>fetch</string>
    </array>
</dict>
</plist>
